# PostgreSQL 18 primary fragment. Replace placeholders outside source control.
listen_addresses = '{{PRIMARY_ADDRESS}}'
wal_level = replica
max_wal_senders = 10
max_replication_slots = 10
wal_keep_size = '4096MB'
# Example budget only: size against the actual storage/runbook and monitor slot invalidation.
max_slot_wal_keep_size = '8192MB'
fsync = on
full_page_writes = on

# Local fsync is the minimum success condition. The application confirms a healthy
# replica separately and automatically retries WAL/resource protection after an outage.
synchronous_standby_names = ''
synchronous_commit = local

archive_mode = on
archive_timeout = '60s'
archive_command = 'powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "{{DEPLOY_ROOT}}/scripts/Invoke-WalArchiveCommand.ps1" "%p" "%f" "{{ARCHIVE_ROOT}}"'

password_encryption = scram-sha-256
ssl = on
log_connections = on
log_disconnections = on
log_lock_waits = on
deadlock_timeout = '1s'
