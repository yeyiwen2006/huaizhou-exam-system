{
  "ExamServer": {
    "ServerId": "synthetic-server",
    "NodeId": "synthetic-node",
    "ServerEpoch": 1
  },
  "Management": {
    "ServiceConfigurationPath": "/srv/exam/configuration/service.json",
    "ProtectedBusinessLogPath": "/srv/exam/protected-logs/business.jsonl",
    "MinimumAvailableBytes": 1073741824
  },
  "Confirmation": {
    "Directory": "/srv/exam/confirmation-journal",
    "PrimaryNodeId": "synthetic-node",
    "StandbyNodeId": "synthetic-standby",
    "StandbyHttpsUrl": "https://standby.example.invalid/"
  },
  "Backup": {
    "VersionedResourcesDirectory": "/srv/exam/resources"
  },
  "Kestrel": {
    "Certificates": {
      "Default": {
        "Path": "/srv/exam/protected/business-tls.pfx"
      }
    }
  },
  "PackageSecurity": {
    "CertificatePath": "/srv/exam/protected/node.pfx",
    "RecipientCertificatePaths": {
      "synthetic-node": "/srv/exam/protected/node.cer",
      "synthetic-standby": "/srv/exam/protected/standby.cer"
    }
  }
}
