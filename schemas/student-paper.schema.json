{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://huaizhou.example/schemas/student-paper.schema.json",
  "title": "Student display manifest",
  "description": "D03 输出 ZIP 内的 manifest.json。与服务器导入清单分离，不含计分规则、答案或源文件路径。跨字段唯一性、路径、PDF 检查以及 v2 才允许附带 option-regions.json 的规则由 StudentPaperPackage 执行。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "examId", "examName", "paperVersion", "subjects", "groups", "questions", "displayResources"],
  "properties": {
    "schemaVersion": {
      "enum": [1, 2],
      "description": "1 为既有清单，不带选项坐标，学生端不猜测点击位置；2 表示包内根目录必须附带 option-regions.json，缺文件或坐标无效时整包失败。两个版本字段与坐标产物自身的 artifactVersion 相互独立。"
    },
    "examId": { "$ref": "#/$defs/text" },
    "examName": { "$ref": "#/$defs/text" },
    "paperVersion": { "type": "integer", "minimum": 1 },
    "subjects": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["subjectId", "name"],
        "properties": { "subjectId": { "$ref": "#/$defs/text" }, "name": { "$ref": "#/$defs/text" } }
      }
    },
    "groups": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["groupId", "subjectId", "name", "order"],
        "properties": { "groupId": { "$ref": "#/$defs/text" }, "subjectId": { "$ref": "#/$defs/text" }, "name": { "$ref": "#/$defs/text" }, "order": { "type": "integer", "minimum": 1 } }
      }
    },
    "questions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["structure", "pdfPath"],
        "properties": {
          "structure": {
            "type": "object", "additionalProperties": false,
            "required": ["questionId", "questionNo", "subjectId", "groupId", "questionType", "optionIds"],
            "properties": {
              "questionId": { "$ref": "#/$defs/text" },
              "questionNo": { "type": "integer", "minimum": 1 },
              "subjectId": { "$ref": "#/$defs/text" },
              "groupId": { "$ref": "#/$defs/text" },
              "questionType": { "enum": ["single", "multiple", "indeterminate"] },
              "optionIds": { "type": "array", "minItems": 2, "maxItems": 26, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
              "allowAbstain": { "type": "boolean", "default": false }
            }
          },
          "pdfPath": { "type": "string", "maxLength": 512, "pattern": "^questions/.+\\.pdf$" },
          "optionCaptions": { "type": "array", "minItems": 2, "maxItems": 26, "items": { "$ref": "#/$defs/text" } }
        }
      }
    },
    "displayResources": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text", "maxLength": 512 } }
  },
  "$defs": { "text": { "type": "string", "minLength": 1 } }
}
