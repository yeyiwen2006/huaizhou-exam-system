% 合成共享样式（图形与化学式样包）。仅用于仓库内的合成样包，不含任何真实试卷内容。
% 每个导入包自带共享样式，因此本样式同样定义选项标记约定，与 three-types 的样式保持同一约定。
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{exam-chemistry}[2026/09/22 v1 synthetic chemistry style]

\RequirePackage{amsmath}
\RequirePackage{graphicx}
\RequirePackage{mhchem}
\RequirePackage{hyperref}
\hypersetup{hidelinks}

% \optmark{题目标识}{选项标识}{选项显示文本}
% 在选项显示文本外建立隐藏外观链接（hidelinks，/Border [0 0 0]）；不改变外观与占位。
% 目标名固定为 opt:<题目标识>:<选项标识>，只含题目与选项标识，不含答案或分值等计分信息。
% D03 用 PdfPig 读取该链接标注的 /Rect，转成页面左上角归一化坐标
% （anchorScheme=pageTopLeftNormalizedV1），随 paperVersion 作为版本产物发布；
% B03 据此在选项字母处叠加圆形选择控件，圆钮第 i 个对应 options[i]。
% 契约见 docs/d03-option-region-contract.md。
\DeclareRobustCommand{\optmark}[3]{\hypertarget{opt:#1:#2}{}\hyperlink{opt:#1:#2}{#3}}

% 合成自定义命令，模拟真实试卷中的专用宏与单位宏。
% \syntheticamount 在文本与数学模式下都可用，故用 \ensuremath。
\newcommand{\syntheticamount}[2]{\ensuremath{#1\,\mathrm{#2}}}
\newcommand{\syntheticfigure}[1]{\includegraphics[width=0.34\linewidth]{#1}}
