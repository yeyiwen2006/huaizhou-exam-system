{
  "ExamServer": {
    "ServerId": "",
    "NodeId": "",
    "ServerEpoch": 0
  },
  "Database": {
    "ApplyMigrations": false,
    "CommandTimeoutSeconds": 30,
    "ConnectionTimeoutSeconds": 15,
    "MaxConcurrentWrites": 32
  },
  "RequestCapacity": {
    "QueueLimit": 300,
    "QueueTimeoutMilliseconds": 5000,
    "TransportConnectionLimit": 2048
  },
  "Backup": {
    "Enabled": false,
    "ToolTimeoutMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
