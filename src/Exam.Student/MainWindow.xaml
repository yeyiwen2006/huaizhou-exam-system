<Window x:Class="Exam.Student.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="怀籀传承在线考试系统 · 学生端"
        MinWidth="1000"
        MinHeight="640"
        Width="1280"
        Height="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}"
        FontFamily="{DynamicResource Font.Family}">
    <!-- 登录后以普通账户权限全屏显示，并拦截离开考试的快捷键 -->
    <DockPanel>
        <TextBlock x:Name="PresenceStatus" DockPanel.Dock="Bottom" Text="{Binding PresenceStatus}"
                   Foreground="#B45309" TextAlignment="Center" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding PresenceStatus}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <ContentControl x:Name="PageRegion" />
    </DockPanel>
</Window>
