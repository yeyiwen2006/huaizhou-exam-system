<UserControl x:Class="Exam.Student.Views.ActivationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Exam.Desktop.Shared.Controls;assembly=Exam.Desktop.Shared"
             Background="{DynamicResource Brush.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0"
                            ClientNumber="{Binding ClientNumber, Mode=OneWay}" />

        <!-- 居中激活卡片：品牌头部 + 表单 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource Card}"
                    Width="440"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="24">
                <StackPanel DataContext="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <Border Style="{StaticResource BrandBand}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Logo}" Stroke="{DynamicResource Brush.OnPrimary}"
                                      Style="{StaticResource Icon.Stroke}" Width="18" Height="18" Margin="0,0,8,0" />
                                <TextBlock Style="{StaticResource BrandBand.Caption}" Text="怀籀传承在线考试系统" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource BrandBand.Title}" Text="学生端激活" Margin="0,14,0,0" />
                            <TextBlock Style="{StaticResource BrandBand.Caption}"
                                       Text="首次使用需连接服务器申请激活，激活需考务端批准。"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="28,24,28,28">
                        <controls:Banner x:Name="ConfigBanner"
                                         Margin="0,0,0,14" />

                        <controls:ValidatedInput x:Name="HostInput"
                                                 Label="服务器 IP 地址"
                                                 Watermark="例如 192.168.1.10"
                                                 InputChanged="OnInputChanged" />
                        <controls:ValidatedInput x:Name="PortInput"
                                                Label="服务器端口"
                                                Watermark="例如 5001"
                                                IsNumericOnly="True"
                                                Text="5001"
                                                Margin="0,14,0,0"
                                                InputChanged="OnInputChanged" />

                        <DockPanel Margin="0,18,0,0">
                            <TextBlock Text="激活状态" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <controls:StatusPill x:Name="ActivationPill"
                                                Text="未激活"
                                                Level="Neutral"
                                                HorizontalAlignment="Left" />
                        </DockPanel>

                        <TextBlock x:Name="ActivationCodeText" Margin="0,12,0,0"
                                   TextWrapping="Wrap" Visibility="Collapsed" FontWeight="SemiBold"/>

                        <Button x:Name="RequestButton"
                                Style="{StaticResource Btn.Primary}"
                                Content="请求激活"
                                Height="{StaticResource Control.Height.Large}"
                                FontSize="{DynamicResource Font.Size.Body.Large}"
                                Margin="0,20,0,0"
                                Click="OnRequestActivation" />

                        <controls:Banner x:Name="ErrorBanner"
                                        Level="Danger"
                                        Margin="0,16,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

    </Grid>
</UserControl>
