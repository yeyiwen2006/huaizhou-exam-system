<UserControl x:Class="Exam.Student.Views.ExamInProgressPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Exam.Desktop.Shared.Controls;assembly=Exam.Desktop.Shared"
             xmlns:views="clr-namespace:Exam.Student.Views"
             Background="{DynamicResource Brush.Background}">
    <UserControl.Resources>
        <!-- 左侧题号方框：已作答绿色；当前题主色描边；右上角红点为私人标记。 -->
        <Style x:Key="NavBoxStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,3,3" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Shell"
                                    CornerRadius="8"
                                    Background="{DynamicResource Brush.Surface.Alt}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1.5">
                                <Viewbox StretchDirection="DownOnly" Margin="3">
                                    <TextBlock Text="{Binding QuestionNo, Mode=OneWay}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Text.Primary}" />
                                </Viewbox>
                            </Border>
                            <Ellipse x:Name="MarkDot"
                                     Width="10" Height="10"
                                     HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Margin="0,2,2,0"
                                     Fill="{DynamicResource Brush.Mark}"
                                     Visibility="{Binding IsMarked, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsAnswered, Mode=OneWay}" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Brush.Answer.Soft}" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Brush.Answer}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent, Mode=OneWay}" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                                <Setter TargetName="Shell" Property="BorderThickness" Value="2.5" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0"
                             ClientNumber="{Binding ClientNumber, Mode=OneWay}"
                             CandidateName="{Binding CandidateDisplay, Mode=OneWay}">
            <controls:PageHeader.RightContent>
                <!-- 右上角红色“提交答卷”；服务器时间按需求显示在右下角状态条 -->
                <Button Style="{StaticResource Btn.Danger}"
                        Content="提交答卷"
                        MinWidth="112"
                        Padding="16,0"
                        IsEnabled="{Binding Submit.IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                        Click="OnSubmit" />
            </controls:PageHeader.RightContent>
        </controls:PageHeader>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：按科目、题组显示题号方框，点击跳题 -->
            <Border Grid.Column="0"
                    Style="{StaticResource Card}"
                    Width="360"
                    Padding="14,14,8,12">
                <DockPanel>
                    <!-- 图例：颜色语义与题号方框一致 -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                            Padding="0,10,0,0" Margin="0,8,6,0">
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                <Border Width="14" Height="14" CornerRadius="4" Background="{DynamicResource Brush.Answer.Soft}"
                                        BorderBrush="{DynamicResource Brush.Answer}" BorderThickness="1.5" />
                                <TextBlock Text="已作答" Style="{StaticResource CaptionText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                <Border Width="14" Height="14" CornerRadius="4" Background="{DynamicResource Brush.Surface.Alt}"
                                        BorderBrush="{DynamicResource Brush.Primary}" BorderThickness="2" />
                                <TextBlock Text="当前题" Style="{StaticResource CaptionText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                <Border Width="14" Height="14" CornerRadius="4" Background="{DynamicResource Brush.Surface.Alt}"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1.5" />
                                <TextBlock Text="未作答" Style="{StaticResource CaptionText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Ellipse Width="9" Height="9" Fill="{DynamicResource Brush.Mark}" VerticalAlignment="Center" />
                                <TextBlock Text="已标记" Style="{StaticResource CaptionText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                    <ScrollViewer x:Name="NavigationScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,6,0">
                            <ItemsControl x:Name="NavList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock Style="{StaticResource SectionTitle}"
                                                       FontSize="{DynamicResource Font.Size.Body.Large}"
                                                       Text="{Binding SubjectName, Mode=OneWay}" TextWrapping="Wrap"
                                                       Visibility="{Binding ShowSubjectHeading, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Style="{StaticResource CaptionText}"
                                                       Text="{Binding GroupTitle, Mode=OneWay}"
                                                       Margin="0,6,0,8" TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding Boxes, Mode=OneWay}" HorizontalAlignment="Stretch">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="10" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource NavBoxStyle}"
                                                                Tag="{Binding QuestionId, Mode=OneWay}"
                                                                Click="OnNavBoxClick" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="考试计分说明" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
                                    <ItemsControl x:Name="InstructionList" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 右侧：原版题目显示 -->
            <Border Grid.Column="1"
                    Style="{StaticResource Card}"
                    Margin="12,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 题目上方工具行：当前题号 + 标记本题 -->
                    <Grid Grid.Row="0" Margin="4,4,4,8">
                        <TextBlock x:Name="CurrentQuestionText"
                                   Style="{StaticResource SectionTitle}"
                                   FontSize="{DynamicResource Font.Size.Subtitle}"
                                   VerticalAlignment="Center"
                                   Text="题目尚不可用" />
                        <Button x:Name="MarkButton"
                                Style="{StaticResource Btn.Secondary}"
                                Content="标记本题"
                                Padding="14,0"
                                IsEnabled="False"
                                HorizontalAlignment="Right"
                                Click="OnToggleMark" />
                    </Grid>

                    <!-- 状态横幅：解锁/交卷状态、运行时错误、本地保存错误、在线更新 -->
                    <StackPanel Grid.Row="1" Margin="4,0,4,8">
                        <controls:Banner x:Name="PaperBanner" Level="Info" />
                        <controls:Banner x:Name="PaperUpdateBanner" Level="Warning" Margin="0,8,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="ReviewUpdateButton" Style="{StaticResource Btn.Secondary}"
                                    Content="已查看更正后的试题"
                                    Padding="14,5"
                                    Visibility="Collapsed"
                                    Click="OnConfirmReview" />
                            <Button x:Name="JumpToChangedButton" Style="{StaticResource Btn.Secondary}"
                                    Content="查看修订试题"
                                    Margin="8,0,0,0"
                                    Padding="14,5"
                                    Visibility="Collapsed"
                                    Click="OnJumpToChangedQuestion" />
                        </StackPanel>
                        <controls:Banner x:Name="RuntimeErrorBanner" Level="Danger" Margin="0,8,0,0" />
                        <controls:Banner x:Name="LocalStateErrorBanner" Level="Danger" Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- 原版题目 + 圆形选项控件 -->
                    <views:PdfQuestionView x:Name="QuestionView" Grid.Row="2" Margin="4,0,4,0" />

                    <!--
                      底部状态条：右下角显示服务器时间与剩余时间（需求第 66 行）。
                      本机保存、上报正常时左侧不显示任何文字；只在考生需要知道或需要处理时显示一句提示。
                    -->
                    <Border Grid.Row="3"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="0,1,0,0"
                            Margin="4,10,4,2"
                            Padding="0,8,0,0">
                        <DockPanel>
                            <ContentControl DockPanel.Dock="Right"
                                            Content="{Binding ClockPillContent, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                            VerticalAlignment="Center"
                                            Margin="16,0,0,0" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="StatusNotice" Style="{StaticResource BodyText}"
                                           Foreground="{DynamicResource Brush.Warning}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="560"
                                           Visibility="Collapsed" />
                                <Button x:Name="RetryLocalSaveButton" Style="{StaticResource Btn.Secondary}"
                                        Content="重试保存" Margin="12,0,0,0" Padding="12,4"
                                        Visibility="Collapsed" Click="OnRetryLocalSave" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 设备裁决/撤权撤销遮罩：本设备被撤销后停止作答，仅允许返回选择考试 -->
        <Border x:Name="RevokedOverlay"
                Grid.RowSpan="2"
                Background="{DynamicResource Brush.Scrim}"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                <TextBlock Style="{StaticResource SectionTitle}"
                           FontSize="{DynamicResource Font.Size.Body.Large}"
                           HorizontalAlignment="Center"
                           Text="本机已停止作答" />
                <TextBlock x:Name="RevokedOverlayText"
                           Style="{StaticResource BodyText}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           Text="本场考试已改由另一台设备继续作答。本机已作答内容已保留，请听从监考人员安排。" />
                <Button Style="{StaticResource Btn.Secondary}"
                        Content="返回选择考试"
                        Margin="0,18,0,0"
                        HorizontalAlignment="Center"
                        Click="OnRevokedBack" />
            </StackPanel>
        </Border>

        <controls:BusyOverlay x:Name="Busy"
                              Grid.RowSpan="2"
                              Message="正在提交答卷…" />
    </Grid>
</UserControl>
