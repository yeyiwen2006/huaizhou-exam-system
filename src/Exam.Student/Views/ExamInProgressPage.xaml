<UserControl x:Class="Exam.Student.Views.ExamInProgressPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Exam.Desktop.Shared.Controls;assembly=Exam.Desktop.Shared"
             Background="{DynamicResource Brush.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0"
                             ClientNumber="{Binding ClientNumber, Mode=OneWay}"
                             CandidateName="{Binding CandidateDisplay, Mode=OneWay}">
            <controls:PageHeader.RightContent>
                <StackPanel Orientation="Horizontal">
                    <ContentControl Content="{Binding ClockPillContent, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                    VerticalAlignment="Center" />
                    <Button Style="{StaticResource Btn.Danger}"
                            Content="提交答卷"
                            IsEnabled="False"
                            Margin="16,0,0,0"
                            Click="OnSubmit" />
                </StackPanel>
            </controls:PageHeader.RightContent>
        </controls:PageHeader>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：试题切换栏 -->
            <Border Grid.Column="0"
                    Style="{StaticResource Card}"
                    Width="280"
                    Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="NavList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Style="{StaticResource SectionTitle}"
                                               FontSize="{DynamicResource Font.Size.Body.Large}"
                                               Text="{Binding SubjectTitle}" />
                                    <TextBlock Style="{StaticResource CaptionText}"
                                               Text="{Binding GroupTitle}"
                                               Margin="0,6,0,8" />
                                    <ItemsControl ItemsSource="{Binding Boxes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- 右侧：当前试题 -->
            <Border Grid.Column="1"
                    Style="{StaticResource Card}"
                    Margin="12,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 题目上方工具行：标记本题 + 当前题号 -->
                    <Grid Grid.Row="0" Margin="4,4,4,12">
                        <TextBlock x:Name="CurrentQuestionText"
                                   Style="{StaticResource SectionTitle}"
                                   Text="题目尚不可用" />
                        <Button x:Name="MarkButton"
                                Style="{StaticResource Btn.Secondary}"
                                Content="标记本题"
                                IsEnabled="False"
                                HorizontalAlignment="Right"
                                Click="OnToggleMark" />
                    </Grid>

                    <!-- B03 接入：题干 + 图片（居中、按 LaTeX 版式）+ 选项（圆形按钮） -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <controls:Banner x:Name="PaperBanner"
                                            Level="Info"
                                            IsOpen="True"
                                            Message="当前版本尚未提供答题与交卷功能，请联系考务人员。此页面不能用于正式考试。" />
                            <controls:Banner x:Name="RuntimeErrorBanner" Level="Danger" Margin="0,12,0,0" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="本地保存与恢复" Margin="0,20,0,0" />
                            <TextBlock x:Name="LocalStateText" Style="{StaticResource BodyText}" Margin="0,8,0,0" />
                            <controls:Banner x:Name="LocalStateErrorBanner" Level="Danger" Margin="0,8,0,0" />
                            <Button x:Name="RetryLocalSaveButton" Style="{StaticResource Btn.Secondary}"
                                    Content="重试本地保存" HorizontalAlignment="Left" Margin="0,12,0,0"
                                    Visibility="Collapsed" Click="OnRetryLocalSave" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <controls:BusyOverlay x:Name="Busy"
                              Grid.RowSpan="2"
                              Message="正在提交答卷…" />
    </Grid>
</UserControl>
