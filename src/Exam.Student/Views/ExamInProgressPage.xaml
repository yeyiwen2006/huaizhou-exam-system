<UserControl x:Class="Exam.Student.Views.ExamInProgressPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Exam.Desktop.Shared.Controls;assembly=Exam.Desktop.Shared"
             Background="{DynamicResource Brush.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0"
                             ClientNumber="{Binding ClientNumber, Mode=OneWay}"
                             CandidateName="{Binding CandidateDisplay, Mode=OneWay}">
            <controls:PageHeader.RightContent>
                <StackPanel Orientation="Horizontal">
                    <ContentControl Content="{Binding ClockPillContent, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                    VerticalAlignment="Center" />
                    <Button Style="{StaticResource Btn.Danger}"
                            Content="提交答卷"
                            Margin="16,0,0,0"
                            Click="OnSubmit" />
                </StackPanel>
            </controls:PageHeader.RightContent>
        </controls:PageHeader>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：试题切换栏 -->
            <Border Grid.Column="0"
                    Style="{StaticResource Card}"
                    Width="280"
                    Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="NavList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Style="{StaticResource SectionTitle}"
                                               FontSize="{DynamicResource Font.Size.Body.Large}"
                                               Text="{Binding SubjectTitle}" />
                                    <TextBlock Style="{StaticResource CaptionText}"
                                               Text="{Binding GroupTitle}"
                                               Margin="0,6,0,8" />
                                    <ItemsControl ItemsSource="{Binding Boxes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- 右侧：当前试题 -->
            <Border Grid.Column="1"
                    Style="{StaticResource Card}"
                    Margin="12,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 题目上方工具行：标记本题 + 当前题号 -->
                    <Grid Grid.Row="0" Margin="4,4,4,12">
                        <TextBlock x:Name="CurrentQuestionText"
                                   Style="{StaticResource SectionTitle}"
                                   Text="第 1 题" />
                        <Button x:Name="MarkButton"
                                Style="{StaticResource Btn.Secondary}"
                                Content="标记本题"
                                HorizontalAlignment="Right"
                                Click="OnToggleMark" />
                    </Grid>

                    <!-- B03 接入：题干 + 图片（居中、按 LaTeX 版式）+ 选项（圆形按钮） -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <controls:Banner Level="Info"
                                            IsOpen="True"
                                            Message="题目内容区：B03 接入原版 PDF 试题显示、题内图片与选项圆形按钮。当前为 B01 页框。" />
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <TextBlock Style="{StaticResource CaptionText}"
                                           Text="图例："
                                           VerticalAlignment="Center" />
                                <controls:QuestionBox Number="1" Margin="6,0,0,0" />
                                <controls:QuestionBox Number="2" IsAnswered="True" Margin="6,0,0,0" />
                                <controls:QuestionBox Number="3" IsMarked="True" Margin="6,0,0,0" />
                                <controls:QuestionBox Number="4" IsAnswered="True" IsMarked="True" Margin="6,0,0,0" />
                                <TextBlock Style="{StaticResource CaptionText}"
                                           Text="已答 / 标记 / 已答且标记"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <controls:BusyOverlay x:Name="Busy"
                              Grid.RowSpan="2"
                              Message="正在提交答卷…" />
    </Grid>
</UserControl>
