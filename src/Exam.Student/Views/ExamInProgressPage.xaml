<UserControl x:Class="Exam.Student.Views.ExamInProgressPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Exam.Desktop.Shared.Controls;assembly=Exam.Desktop.Shared"
             xmlns:views="clr-namespace:Exam.Student.Views"
             Background="{DynamicResource Brush.Background}">
    <UserControl.Resources>
        <!-- 左侧题号方框：已作答绿色；当前题主色描边；右上角红点为私人标记。 -->
        <Style x:Key="NavBoxStyle" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Shell"
                                    CornerRadius="8"
                                    Background="{DynamicResource Brush.Surface.Alt}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1.5">
                                <TextBlock Text="{Binding QuestionNo, Mode=OneWay}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Primary}" />
                            </Border>
                            <Ellipse x:Name="MarkDot"
                                     Width="10" Height="10"
                                     HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Margin="0,2,2,0"
                                     Fill="{DynamicResource Brush.Mark}"
                                     Visibility="{Binding IsMarked, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsAnswered, Mode=OneWay}" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Brush.Answer.Soft}" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Brush.Answer}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent, Mode=OneWay}" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                                <Setter TargetName="Shell" Property="BorderThickness" Value="2.5" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0"
                             ClientNumber="{Binding ClientNumber, Mode=OneWay}"
                             CandidateName="{Binding CandidateDisplay, Mode=OneWay}">
            <controls:PageHeader.RightContent>
                <StackPanel Orientation="Horizontal">
                    <ContentControl Content="{Binding ClockPillContent, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                    VerticalAlignment="Center" />
                    <Button Style="{StaticResource Btn.Danger}"
                            Content="提交答卷"
                            IsEnabled="{Binding Submit.IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                            Margin="16,0,0,0"
                            Click="OnSubmit" />
                </StackPanel>
            </controls:PageHeader.RightContent>
        </controls:PageHeader>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：按科目、题组显示题号方框，点击跳题 -->
            <Border Grid.Column="0"
                    Style="{StaticResource Card}"
                    Width="280"
                    Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="NavList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Style="{StaticResource SectionTitle}"
                                               FontSize="{DynamicResource Font.Size.Body.Large}"
                                               Text="{Binding SubjectName, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource CaptionText}"
                                               Text="{Binding GroupTitle, Mode=OneWay}"
                                               Margin="0,6,0,8" />
                                    <ItemsControl ItemsSource="{Binding Boxes, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource NavBoxStyle}"
                                                        Tag="{Binding QuestionId, Mode=OneWay}"
                                                        Click="OnNavBoxClick" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- 右侧：原版题目显示（B03） -->
            <Border Grid.Column="1"
                    Style="{StaticResource Card}"
                    Margin="12,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 题目上方工具行：当前题号 + 标记本题 -->
                    <Grid Grid.Row="0" Margin="4,4,4,8">
                        <TextBlock x:Name="CurrentQuestionText"
                                   Style="{StaticResource SectionTitle}"
                                   VerticalAlignment="Center"
                                   Text="题目尚不可用" />
                        <Button x:Name="MarkButton"
                                Style="{StaticResource Btn.Secondary}"
                                Content="标记本题"
                                IsEnabled="False"
                                HorizontalAlignment="Right"
                                Click="OnToggleMark" />
                    </Grid>

                    <!-- 状态横幅：解锁/交卷状态、运行时错误、本地保存错误 -->
                    <StackPanel Grid.Row="1" Margin="4,0,4,8">
                        <controls:Banner x:Name="PaperBanner" Level="Info" />
                        <controls:Banner x:Name="RuntimeErrorBanner" Level="Danger" Margin="0,8,0,0" />
                        <controls:Banner x:Name="LocalStateErrorBanner" Level="Danger" Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- 原版题目 + 圆形选项控件 -->
                    <views:PdfQuestionView x:Name="QuestionView" Grid.Row="2" Margin="4,0,4,0" />

                    <!-- 底部状态条：本地保存（B04）与服务器同步（B05） -->
                    <Border Grid.Row="3"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="0,1,0,0"
                            Margin="4,10,4,2"
                            Padding="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="LocalStateText" Style="{StaticResource BodyText}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
                            <Button x:Name="RetryLocalSaveButton" Style="{StaticResource Btn.Secondary}"
                                    Content="重试本地保存" Margin="12,0,0,0" Padding="12,4"
                                    Visibility="Collapsed" Click="OnRetryLocalSave" />
                            <TextBlock x:Name="SyncStatusText" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                       Margin="16,0,0,0" Text="同步服务尚未启动。" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <controls:BusyOverlay x:Name="Busy"
                              Grid.RowSpan="2"
                              Message="正在提交答卷…" />
    </Grid>
</UserControl>
