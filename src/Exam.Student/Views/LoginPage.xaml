<UserControl x:Class="Exam.Student.Views.LoginPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Exam.Desktop.Shared.Controls;assembly=Exam.Desktop.Shared"
             Background="{DynamicResource Brush.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0">
            <controls:PageHeader.RightContent>
                <Button AutomationProperties.AutomationId="ExitSystemButton"
                        Style="{StaticResource Btn.Danger}"
                        Content="退出系统"
                        Click="OnExitSystem" />
            </controls:PageHeader.RightContent>
        </controls:PageHeader>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource Card}"
                    Width="440"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="24">
                <StackPanel>
                    <Border Style="{StaticResource BrandBand}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Logo}" Stroke="{DynamicResource Brush.OnPrimary}"
                                      Style="{StaticResource Icon.Stroke}" Width="18" Height="18" Margin="0,0,8,0" />
                                <TextBlock Style="{StaticResource BrandBand.Caption}" Text="怀籀传承在线考试系统" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource BrandBand.Title}" Text="考生登录" Margin="0,14,0,0" />
                            <TextBlock Style="{StaticResource BrandBand.Caption}"
                                       Text="填写服务器地址和考生信息后登录，默认使用 HTTPS 安全连接。"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="28,24,28,20">
                        <controls:ValidatedInput x:Name="HostInput"
                                                 Label="服务器地址（IP 或域名）"
                                                 Watermark="请输入服务器 IP 地址或域名"
                                                 ToolTip="例如 exam.example.com，默认使用 HTTPS 443；也可填写部署人员提供的完整 HTTPS 地址"
                                                 InputChanged="OnInputChanged" />
                        <controls:ValidatedInput x:Name="NameInput"
                                                 Label="姓名"
                                                 Margin="0,14,0,0"
                                                 Watermark="请输入姓名"
                                                 InputChanged="OnInputChanged" />
                        <controls:ValidatedInput x:Name="ClassInput"
                                                 Label="班级（数字）"
                                                 Watermark="请输入班级，如 2"
                                                 IsNumericOnly="True"
                                                 Margin="0,14,0,0"
                                                 InputChanged="OnInputChanged" />
                        <controls:ValidatedInput x:Name="AdmissionInput"
                                                 Label="准考证号（数字）"
                                                 Watermark="请输入准考证号"
                                                 IsNumericOnly="True"
                                                 Margin="0,14,0,0"
                                                 InputChanged="OnInputChanged" />

                        <Button x:Name="LoginButton"
                                Style="{StaticResource Btn.Primary}"
                                Content="登录"
                                Height="{StaticResource Control.Height.Large}"
                                FontSize="{DynamicResource Font.Size.Body.Large}"
                                Margin="0,22,0,0"
                                IsEnabled="False"
                                Click="OnLogin" />

                        <controls:Banner x:Name="ErrorBanner"
                                        Level="Danger"
                                        Margin="0,16,0,0" />

                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <controls:BusyOverlay x:Name="Busy"
                              Grid.RowSpan="2"
                              Message="正在登录…" />
    </Grid>
</UserControl>
