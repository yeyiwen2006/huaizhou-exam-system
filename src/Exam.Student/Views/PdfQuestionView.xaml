<UserControl x:Class="Exam.Student.Views.PdfQuestionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <!-- 所有普通选项和“不作答”共用实心蓝底白字；选中后使用深蓝色。禁用时仍不透明。 -->
        <Style x:Key="OptionChoiceStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource Brush.Option.Fill}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnPrimary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Option.Selected}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Option.Selected}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OptionCircleStyle" TargetType="ToggleButton" BasedOn="{StaticResource OptionChoiceStyle}">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Ring" Fill="{TemplateBinding Background}" />
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- “不作答”：位于原选项之后，与普通选项互斥；选择、取消及颜色反馈与普通选项一致。 -->
        <Style x:Key="AbstainButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource OptionChoiceStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Shell"
                                CornerRadius="16"
                                Padding="18,8"
                                Background="{TemplateBinding Background}">
                            <TextBlock x:Name="Label"
                                       Text="不 作 答"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer x:Name="PdfScroll"
                      Background="{DynamicResource Brush.Surface.Alt}"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <!-- 题目区至少与可视区域等大，裁去空白后的题目在其中居中；超过一屏时自然下拉。 -->
            <Grid x:Name="PageFrame"
                  MinWidth="{Binding ViewportWidth, ElementName=PdfScroll}"
                  MinHeight="{Binding ViewportHeight, ElementName=PdfScroll}">
                <StackPanel x:Name="PagesHost" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
                    <!-- 动态：每题一页（裁去空白的 Image + 圆钮 Canvas），末尾“不作答” -->
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
