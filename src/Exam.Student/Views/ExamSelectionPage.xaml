<UserControl x:Class="Exam.Student.Views.ExamSelectionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Exam.Desktop.Shared.Controls;assembly=Exam.Desktop.Shared"
             Background="{DynamicResource Brush.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0"
                             ClientNumber="{Binding ClientNumber, Mode=OneWay}"
                             CandidateName="{Binding CandidateDisplay, Mode=OneWay}">
            <controls:PageHeader.RightContent>
                <Button Style="{StaticResource Btn.Danger}"
                        Content="退出系统"
                        Click="OnExitSystem" />
            </controls:PageHeader.RightContent>
        </controls:PageHeader>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,28,32,32" MaxWidth="920">

                <Grid>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="选择考试" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="选择考务端已开放的考试并申请进入。" />
                        <TextBlock x:Name="CurrentTimeText"
                                   Style="{StaticResource BodyText}"
                                   Text="正在同步服务器时间…"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                    <controls:StatusPill x:Name="LoginPill"
                                         Text="已登录"
                                         Level="Success"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center" />
                </Grid>

                <!-- 个人登录状态 -->
                <Border Style="{StaticResource Card}" Margin="0,20,0,0" Padding="20,16">
                    <DockPanel>
                        <Border Style="{StaticResource IconTile}" VerticalAlignment="Center">
                            <Path Style="{StaticResource IconTile.Glyph}" Data="{StaticResource Icon.Users}" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="个人登录状态" Margin="0,0,0,2" />
                            <TextBlock x:Name="CandidateText"
                                       Style="{StaticResource BodyText}"
                                       Text="—" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <controls:Banner x:Name="EntryBanner"
                                Level="Danger"
                                Margin="0,16,0,0" />

                <DockPanel Margin="0,24,0,0">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource Btn.Secondary}"
                            Content="刷新考试列表"
                            Padding="14,0"
                            Click="OnRefresh" />
                    <TextBlock Style="{StaticResource SectionTitle}" Text="可参加的考试" VerticalAlignment="Center" />
                </DockPanel>

                <!-- 可供选择的考试 -->
                <ItemsControl x:Name="ExamList" Margin="0,12,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource IconTile}" Width="44" Height="44" CornerRadius="11" Margin="0,0,16,0">
                                        <Path Style="{StaticResource IconTile.Glyph}" Data="{StaticResource Icon.Document}" Width="22" Height="22" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <!-- 考试名称自动换行，完整显示；状态放在名称下方。 -->
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Name}" TextWrapping="Wrap" />
                                        <controls:StatusPill Text="{Binding StateText}"
                                                             Level="{Binding StateLevel}"
                                                             HorizontalAlignment="Left"
                                                             Margin="0,6,0,0" />
                                        <TextBlock Style="{StaticResource CaptionText}"
                                                   Text="{Binding TimeText}"
                                                   Margin="0,6,0,0" />
                                        <TextBlock Style="{StaticResource CaptionText}"
                                                   Text="{Binding SubjectsText}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Style="{StaticResource Btn.Primary}"
                                            Content="进入考试"
                                            MinWidth="112"
                                            Height="{StaticResource Control.Height.Large}"
                                            VerticalAlignment="Center"
                                            Margin="16,0,0,0"
                                            Click="OnEnterExam"
                                            Tag="{Binding ExamId}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <controls:BusyOverlay x:Name="Busy"
                              Grid.RowSpan="2"
                              Message="正在请求进入考试…" />
    </Grid>
</UserControl>
