<UserControl x:Class="Exam.Student.Views.ExamSelectionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Exam.Desktop.Shared.Controls;assembly=Exam.Desktop.Shared"
             Background="{DynamicResource Brush.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0"
                             ClientNumber="{Binding ClientNumber, Mode=OneWay}"
                             CandidateName="{Binding CandidateDisplay, Mode=OneWay}">
            <controls:PageHeader.RightContent>
                <Button Style="{StaticResource Btn.Danger}"
                        Content="退出系统"
                        Click="OnExitSystem" />
            </controls:PageHeader.RightContent>
        </controls:PageHeader>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24" MaxWidth="920" HorizontalAlignment="Center">

                <Grid>
                    <TextBlock Style="{StaticResource PageTitle}" Text="选择考试" VerticalAlignment="Center" />
                    <controls:StatusPill x:Name="LoginPill"
                                         Text="已登录"
                                         Level="Success"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center" />
                </Grid>

                <!-- 个人登录状态 -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="个人登录状态" />
                        <TextBlock x:Name="CandidateText"
                                   Style="{StaticResource BodyText}"
                                   Margin="0,8,0,0"
                                   Text="—" />
                    </StackPanel>
                </Border>

                <controls:Banner x:Name="EntryBanner"
                                Level="Danger"
                                Margin="0,16,0,0" />

                <!-- 可供选择的考试 -->
                <ItemsControl x:Name="ExamList" Margin="0,16,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Name}" />
                                            <controls:StatusPill Text="{Binding StateText}"
                                                                 Level="{Binding StateLevel}"
                                                                 Margin="12,0,0,0"
                                                                 VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource CaptionText}"
                                                   Text="{Binding TimeText}"
                                                   Margin="0,6,0,0" />
                                        <TextBlock Style="{StaticResource CaptionText}"
                                                   Text="{Binding SubjectsText}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource Btn.Primary}"
                                            Content="进入考试"
                                            VerticalAlignment="Center"
                                            Margin="16,0,0,0"
                                            Click="OnEnterExam"
                                            Tag="{Binding ExamId}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <controls:BusyOverlay x:Name="Busy"
                              Grid.RowSpan="2"
                              Message="正在请求进入考试…" />
    </Grid>
</UserControl>
