<UserControl x:Class="Exam.Student.Views.WaitingExamPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Exam.Desktop.Shared.Controls;assembly=Exam.Desktop.Shared"
             Background="{DynamicResource Brush.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0"
                             ClientNumber="{Binding ClientNumber, Mode=OneWay}"
                             CandidateName="{Binding CandidateDisplay, Mode=OneWay}">
            <controls:PageHeader.RightContent>
                <Button Style="{StaticResource Btn.Danger}"
                        Content="返回"
                        Click="OnGoBack" />
            </controls:PageHeader.RightContent>
        </controls:PageHeader>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24" MaxWidth="860" HorizontalAlignment="Center">

                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource PageTitle}"
                               Text="{Binding ExamName, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <controls:StatusPill x:Name="StatePill"
                                         Text="尚未确认参试"
                                         Level="Info"
                                         Margin="12,0,0,0"
                                         VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="TimeText"
                           Style="{StaticResource BodyText}"
                           Margin="0,8,0,0"
                           Text="—" />
                <TextBlock x:Name="CountdownText"
                           Style="{StaticResource SectionTitle}"
                           Foreground="{DynamicResource Brush.Primary}"
                           Margin="0,8,0,0"
                           Text="" />

                <controls:Banner Level="Info"
                                IsOpen="True"
                                Message="当前版本尚未接通试题下载与参试确认，请联系考务人员。现在尚未计入实际参试，不能开始答题。"
                                Margin="0,16,0,0" />

                <!-- 考试说明（全部科目全部题型） -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="考试说明" />
                        <ItemsControl x:Name="InstructionList" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource BodyText}"
                                               Text="{Binding}"
                                               Margin="0,0,0,6" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- B02 接入：试题下载状态、解密、自动进入考试 -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="试题下载" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <controls:StatusPill x:Name="DownloadPill"
                                                 Text="下载尚不可用"
                                                 Level="Neutral" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
