<UserControl x:Class="Exam.Student.Views.WaitingExamPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Exam.Desktop.Shared.Controls;assembly=Exam.Desktop.Shared"
             Background="{DynamicResource Brush.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0"
                             ClientNumber="{Binding ClientNumber, Mode=OneWay}"
                             CandidateName="{Binding CandidateDisplay, Mode=OneWay}">
            <controls:PageHeader.RightContent>
                <Button Style="{StaticResource Btn.Danger}"
                        Content="返回"
                        Click="OnGoBack" />
            </controls:PageHeader.RightContent>
        </controls:PageHeader>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24" MaxWidth="860" HorizontalAlignment="Center">

                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource PageTitle}"
                               Text="{Binding ExamName, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <controls:StatusPill x:Name="StatePill"
                                         Text="准备中"
                                         Level="Neutral"
                                         Margin="12,0,0,0"
                                         VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="TimeText"
                           Style="{StaticResource BodyText}"
                           Margin="0,8,0,0"
                           Text="—" />
                <TextBlock x:Name="CountdownText"
                           Style="{StaticResource SectionTitle}"
                           Foreground="{DynamicResource Brush.Primary}"
                           Margin="0,8,0,0"
                           Text="" />

                <controls:Banner x:Name="InfoBanner"
                                Level="Info"
                                IsOpen="True"
                                Message="试题包将在进入本页后自动下载；下载与考试说明齐备并确认参试后，等待开考指令自动解密进入考试。"
                                Margin="0,16,0,0" />

                <controls:Banner x:Name="ErrorBanner"
                                Level="Error"
                                IsOpen="False"
                                Message=""
                                Margin="0,16,0,0" />

                <!-- 试题下载（B02） -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="试题下载" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <controls:StatusPill x:Name="DownloadPill"
                                                 Text="未开始"
                                                 Level="Neutral" />
                            <TextBlock x:Name="DownloadDetail"
                                       Style="{StaticResource BodyText}"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="" />
                        </StackPanel>
                        <ProgressBar x:Name="DownloadBar"
                                     Height="8"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Margin="0,12,0,0" />
                        <Button x:Name="RetryDownloadButton"
                                Style="{StaticResource Btn.Secondary}"
                                Content="重试下载"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Left"
                                Visibility="Collapsed"
                                Click="OnRetryDownload" />
                    </StackPanel>
                </Border>

                <!-- 考试说明（下载的说明资源；字体约定由说明文本自身携带，C01 评审） -->
                <Border x:Name="InstructionCard"
                        Style="{StaticResource Card}"
                        Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="考试说明" />
                        <ItemsControl x:Name="InstructionList" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource BodyText}"
                                               Text="{Binding}"
                                               Margin="0,0,0,6" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 确认参试（B02：包与说明齐备才可点） -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="参试确认" />
                        <TextBlock x:Name="ConfirmHint"
                                   Style="{StaticResource BodyText}"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Margin="0,8,0,0"
                                   Text="试题包与考试说明齐备后才能确认参试。" />
                        <Button x:Name="ConfirmButton"
                                Style="{StaticResource Btn.Primary}"
                                Content="确认参试"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Left"
                                IsEnabled="False"
                                Click="OnConfirmParticipation" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <controls:BusyOverlay x:Name="BusyLayer"
                              Grid.Row="0"
                              Grid.RowSpan="2"
                              Message="正在处理…" />
    </Grid>
</UserControl>
