<Window x:Class="Exam.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:reporting="clr-namespace:Exam.Admin.Reporting"
        xmlns:controls="clr-namespace:Exam.Desktop.Shared.Controls;assembly=Exam.Desktop.Shared"
        Title="怀籀传承在线考试系统 · 考务端" Width="1440" Height="900"
        MinWidth="1120" MinHeight="720"
        Background="{DynamicResource Brush.Background}"
        FontFamily="{DynamicResource Font.Family}"
        UseLayoutRounding="True"
        Closed="MainWindow_OnClosed">
    <Window.Resources>
        <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}" />
        <Style x:Key="FormTextBox" TargetType="TextBox" BasedOn="{StaticResource Tbx.Base}">
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource Btn.Secondary}">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="14,0" />
        </Style>
        <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="14,0" />
        </Style>
        <Style x:Key="PageScroller" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style x:Key="PageBody" TargetType="StackPanel">
            <Setter Property="Margin" Value="{StaticResource Padding.Page}" />
        </Style>
        <Style x:Key="CardGap" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="CardHeading" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="CardNote" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="StatusLine" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <!-- 页头：图标块 + 页面标题（Header）+ 用途说明（Content）；图标几何放在 Tag -->
        <Style x:Key="PageHeading" TargetType="HeaderedContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,0,0,20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="HeaderedContentControl">
                        <DockPanel>
                            <Border Style="{StaticResource IconTile}" Width="44" Height="44" CornerRadius="11">
                                <Path Style="{StaticResource IconTile.Glyph}" Width="22" Height="22"
                                      Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource PageTitle}"
                                           Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" />
                                <TextBlock Style="{StaticResource PageSubtitle}"
                                           Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                            </StackPanel>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <TabControl Style="{StaticResource Nav.TabControl}" Tag="考务端">
        <controls:NavShell.TopBar>
            <!-- 常驻连接条：切换页面时保持不变 -->
            <Border Style="{StaticResource TopBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="0" Text="服务器地址" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Margin="0,0,20,0" Text="{Binding Connection.ServerAddress, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2" Text="考务身份" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBox Grid.Column="3" Margin="0,0,20,0" Text="{Binding Connection.OperatorId, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="4" Text="访问令牌" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" VerticalAlignment="Center"
                               ToolTip="令牌只保存在本进程内存中，不写入磁盘。" />
                    <PasswordBox Grid.Column="5" Margin="0,0,20,0" PasswordChanged="OperatorToken_OnPasswordChanged"
                                 ToolTip="令牌只保存在本进程内存中，不写入磁盘。" />
                    <Button Grid.Column="6" Content="连接服务器" Style="{StaticResource Btn.Primary}" MinWidth="108"
                            Command="{Binding Connection.ConnectCommand}" />
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="7" Orientation="Horizontal" Margin="0,8,0,0">
                        <Path Data="{StaticResource Icon.Server}" Style="{StaticResource IconTile.Glyph}" Width="13" Height="13"
                              Stroke="{DynamicResource Brush.Text.Secondary}" StrokeThickness="1.5" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Connection.Status}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </controls:NavShell.TopBar>

        <TabItem Header="考试配置" Tag="{StaticResource Icon.Calendar}">
            <ScrollViewer Style="{StaticResource PageScroller}">
                <StackPanel Style="{StaticResource PageBody}">
                    <HeaderedContentControl Style="{StaticResource PageHeading}" Header="考试配置" Tag="{StaticResource Icon.Calendar}"
                                    Content="维护考试名称、起止时间、科目与题组计分规则，确认后保存到服务器。" />
                    <Border Style="{StaticResource CardGap}">
                        <StackPanel>
                            <TextBlock Text="考试基础信息" Style="{StaticResource CardHeading}" />
                            <TextBlock Text="考试名称须符合 Windows 文件名规则；时间按“年-月-日 时:分”填写。" Style="{StaticResource CardNote}" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="考试 ID" Style="{StaticResource FormLabel}"/>
                                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Exam.ExamId, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="考试类别" Style="{StaticResource FormLabel}"/>
                                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Exam.CategoryName, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="考试名称" Style="{StaticResource FormLabel}"/>
                                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Exam.Name, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="开始时间" Style="{StaticResource FormLabel}"/>
                                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Exam.ScheduledStartText, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="结束时间" Style="{StaticResource FormLabel}"/>
                                    <TextBox Style="{StaticResource FormTextBox}" Margin="0,0,0,12" Text="{Binding Exam.ScheduledEndText, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,4,0,14" />
                            <WrapPanel>
                                <Button Content="新增科目" Style="{StaticResource ActionButton}" Command="{Binding Exam.AddSubjectCommand}"/>
                                <Button Content="删除科目" Style="{StaticResource ActionButton}" Command="{Binding Exam.RemoveSubjectCommand}"/>
                                <Button Content="校验并生成说明" Style="{StaticResource ActionButton}" Command="{Binding Exam.RefreshInstructionsCommand}"/>
                                <Button Content="加载服务器计划" Style="{StaticResource ActionButton}" Command="{Binding Exam.LoadScheduleCommand}"/>
                                <Button Content="保存计划到服务器" Style="{StaticResource PrimaryAction}" Command="{Binding Exam.SaveScheduleCommand}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding Exam.ScheduleVersionText}" Style="{StaticResource StatusLine}"/>
                            <TextBlock Text="{Binding Exam.Status}" Style="{StaticResource StatusLine}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardGap}">
                        <StackPanel>
                            <TextBlock Text="科目与题组" Style="{StaticResource CardHeading}" />
                            <TextBlock Text="字段与 D01 scoring-rules schema 一致；选中科目后在下方编辑其题组与计分规则。" Style="{StaticResource CardNote}" />
                            <DataGrid ItemsSource="{Binding Exam.Subjects}" SelectedItem="{Binding Exam.SelectedSubject}" IsReadOnly="False" Height="145" Margin="0,0,0,14">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="subjectId" Binding="{Binding SubjectId, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridTextColumn Header="科目名称" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridTextColumn Header="满分" Binding="{Binding MaxScore, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel>
                                <Button Content="新增题组" Style="{StaticResource ActionButton}" Command="{Binding Exam.AddGroupCommand}"/>
                                <Button Content="删除题组" Style="{StaticResource ActionButton}" Command="{Binding Exam.RemoveGroupCommand}"/>
                            </WrapPanel>
                            <DataGrid ItemsSource="{Binding Exam.SelectedSubject.Groups}" SelectedItem="{Binding Exam.SelectedSubject.SelectedGroup}"
                                      IsReadOnly="False" Height="245" HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="groupId" Binding="{Binding GroupId, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                                    <DataGridTextColumn Header="题组名" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                                    <DataGridTemplateColumn Header="type" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged}" MinHeight="28"
                                                          ItemsSource="{Binding DataContext.Exam.QuestionTypes, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="顺序" Binding="{Binding Order, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                    <DataGridTextColumn Header="题量" Binding="{Binding QuestionCount, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                    <DataGridTextColumn Header="满分" Binding="{Binding MaxScore, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                    <DataGridCheckBoxColumn Header="允许不答" Binding="{Binding AllowAbstain}" Width="85"/>
                                    <DataGridTextColumn Header="one.correct" Binding="{Binding Correct}" Width="100"/>
                                    <DataGridTextColumn Header="one.blank" Binding="{Binding OneBlank}" Width="100"/>
                                    <DataGridTextColumn Header="one.wrong" Binding="{Binding OneWrong}" Width="100"/>
                                    <DataGridTextColumn Header="multi.all" Binding="{Binding AllCorrect}" Width="100"/>
                                    <DataGridTextColumn Header="multi.partial" Binding="{Binding PartialCorrect}" Width="110"/>
                                    <DataGridTextColumn Header="multi.blank" Binding="{Binding MultipleBlank}" Width="100"/>
                                    <DataGridTextColumn Header="multi.wrong" Binding="{Binding MultipleWrong}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="校验结果" Style="{StaticResource CardHeading}"/>
                                <Border Style="{StaticResource Hint}" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding Exam.ValidationSummary}" Style="{StaticResource BodyText}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="考生计分说明" Style="{StaticResource CardHeading}"/>
                                <TextBox Text="{Binding Exam.InstructionsText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                         Height="150" Margin="0,10,0,0" Padding="10,8" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="考生名册" Tag="{StaticResource Icon.Users}">
            <ScrollViewer Style="{StaticResource PageScroller}">
                <StackPanel Style="{StaticResource PageBody}">
                    <HeaderedContentControl Style="{StaticResource PageHeading}" Header="考生名册" Tag="{StaticResource Icon.Users}"
                                    Content="手工录入或从 Excel 整体导入考生；任一行有错误都会阻止整批导入。" />
                    <Border Style="{StaticResource CardGap}">
                        <StackPanel>
                            <TextBlock Text="手工录入与 Excel 导入" Style="{StaticResource CardHeading}" />
                            <TextBlock Text="班级与准考证号均为纯数字文本，保留前导零。" Style="{StaticResource CardNote}" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Text="姓名" Style="{StaticResource FormLabel}"/><TextBox Style="{StaticResource FormTextBox}" Text="{Binding Roster.Name, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="班级" Style="{StaticResource FormLabel}"/><TextBox Style="{StaticResource FormTextBox}" Text="{Binding Roster.ClassText, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="准考证号" Style="{StaticResource FormLabel}"/><TextBox Style="{StaticResource FormTextBox}" Text="{Binding Roster.AdmissionNo, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <Button Grid.Column="3" Content="加入名册" Style="{StaticResource Btn.Primary}" MinWidth="96" VerticalAlignment="Bottom" Margin="0,0,0,12" Command="{Binding Roster.AddManualCommand}"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,2,0,14" />
                            <WrapPanel>
                                <Button Content="下载 Excel 模板" Style="{StaticResource ActionButton}" Command="{Binding Roster.CreateTemplateCommand}"/>
                                <Button Content="选择文件并预览" Style="{StaticResource ActionButton}" Command="{Binding Roster.ImportPreviewCommand}"/>
                                <Button Content="确认整体导入" Style="{StaticResource PrimaryAction}" Command="{Binding Roster.ConfirmImportCommand}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding Roster.Status}" Style="{StaticResource StatusLine}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardGap}">
                        <StackPanel>
                            <TextBlock Text="导入预览" Style="{StaticResource CardHeading}" />
                            <TextBlock Text="任一错误都会阻止整批导入；修正 Excel 后重新预览。" Style="{StaticResource CardNote}" />
                            <DataGrid ItemsSource="{Binding Roster.PreviewRows}" Height="220">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="行" Binding="{Binding RowNumber}" Width="60"/><DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="班级" Binding="{Binding ClassText}" Width="*"/><DataGridTextColumn Header="准考证号" Binding="{Binding AdmissionNo}" Width="*"/>
                                    <DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="100"/><DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="本进程名册草稿" Style="{StaticResource CardHeading}" />
                            <TextBlock Text="仅保存在本进程内存中，关闭即丢失，未写入服务器。" Style="{StaticResource CardNote}" />
                            <DataGrid ItemsSource="{Binding Roster.Entries}" Height="220">
                                <DataGrid.Columns><DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="班级" Binding="{Binding ClassText}" Width="*"/><DataGridTextColumn Header="准考证号" Binding="{Binding AdmissionNo}" Width="*"/></DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="激活与房间组" Tag="{StaticResource Icon.Device}">
            <ScrollViewer Style="{StaticResource PageScroller}">
                <StackPanel Style="{StaticResource PageBody}">
                    <HeaderedContentControl Style="{StaticResource PageHeading}" Header="激活与房间组" Tag="{StaticResource Icon.Device}"
                                    Content="审批学生端激活申请、查询设备，并整理房间组草稿。" />
                    <Border Style="{StaticResource CardGap}">
                        <StackPanel>
                            <TextBlock Text="设备激活审批 / 查询" Style="{StaticResource CardHeading}" />
                            <TextBlock Text="权威试场组接口尚未提供，审批时房间组只能留空，设备进入未分组。" Style="{StaticResource CardNote}" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Text="激活申请 ID" Style="{StaticResource FormLabel}"/><TextBox Style="{StaticResource FormTextBox}" Text="{Binding Activation.ActivationRequestId, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="房间组 ID（暂不可指定）" Style="{StaticResource FormLabel}"/><TextBox Style="{StaticResource FormTextBox}" IsEnabled="False" ToolTip="权威试场组接口尚未提供；审批时只能留空，设备进入未分组。" Text="{Binding Activation.ApprovalRoomGroupId, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <Button Grid.Column="2" Content="审批" Style="{StaticResource Btn.Primary}" MinWidth="80" VerticalAlignment="Bottom" Margin="0,0,0,12" Command="{Binding Activation.ApproveCommand}"/>
                                <Border Grid.Column="3" Width="1" Background="{DynamicResource Brush.Border}" Margin="0,4,0,12" HorizontalAlignment="Center" />
                                <StackPanel Grid.Column="4"><TextBlock Text="设备 ID" Style="{StaticResource FormLabel}"/><TextBox Style="{StaticResource FormTextBox}" Text="{Binding Activation.QueryDeviceId, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <Button Grid.Column="5" Content="查询设备" Style="{StaticResource Btn.Secondary}" MinWidth="96" VerticalAlignment="Bottom" Margin="0,0,0,12" Command="{Binding Activation.QueryDeviceCommand}"/>
                            </Grid>
                            <TextBlock Text="{Binding Activation.Status}" Style="{StaticResource CaptionText}" Margin="0,0,0,12"/>
                            <DataGrid ItemsSource="{Binding Activation.Devices}" Height="260">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="设备 ID" Binding="{Binding DeviceId}" Width="*"/><DataGridTextColumn Header="客户端编号" Binding="{Binding ClientNumber}" Width="120"/>
                                    <DataGridTextColumn Header="激活状态" Binding="{Binding ActivationStatus}" Width="110"/><DataGridTextColumn Header="房间组" Binding="{Binding RoomGroupId}" Width="*"/>
                                    <DataGridTextColumn Header="当前考生" Binding="{Binding Candidate}" Width="120"/><DataGridTextColumn Header="连接状态" Binding="{Binding ConnectionStatus}" Width="120"/><DataGridTextColumn Header="最后心跳" Binding="{Binding LastSeen}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="房间组草稿" Style="{StaticResource CardHeading}" />
                            <TextBlock Text="仅为本进程内存草稿，不是服务器分组。" Style="{StaticResource CardNote}" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="新组名称" Style="{StaticResource FormLabel}"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="新增" Style="{StaticResource Btn.Primary}" MinWidth="72" Command="{Binding Activation.AddGroupCommand}"/>
                                        <Button DockPanel.Dock="Right" Content="删除空组" Style="{StaticResource Btn.Danger}" Margin="8,0" Command="{Binding Activation.RemoveGroupCommand}"/>
                                        <TextBox Text="{Binding Activation.NewGroupName, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="选中草稿的新名称" Style="{StaticResource FormLabel}"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="重命名草稿" Style="{StaticResource Btn.Secondary}" Margin="8,0,0,0" Command="{Binding Activation.RenameGroupCommand}"/>
                                        <TextBox Text="{Binding Activation.SelectedGroupName, UpdateSourceTrigger=PropertyChanged}" ToolTip="选中草稿的新名称"/>
                                    </DockPanel>
                                </StackPanel>
                            </Grid>
                            <DataGrid ItemsSource="{Binding Activation.Groups}" SelectedItem="{Binding Activation.SelectedGroup}" Height="145" Margin="0,14,0,0">
                                <DataGrid.Columns><DataGridTextColumn Header="房间组 ID" Binding="{Binding RoomGroupId}" Width="2*"/><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/></DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="监控与处置" Tag="{StaticResource Icon.Monitor}" IsSelected="{Binding Monitoring.IsPageActive, Mode=TwoWay}">
            <ScrollViewer Style="{StaticResource PageScroller}">
                <StackPanel Style="{StaticResource PageBody}">
                    <HeaderedContentControl Style="{StaticResource PageHeading}" Header="监控与处置" Tag="{StaticResource Icon.Monitor}"
                                    Content="查看考场参与状态与收齐事件，处理设备冲突裁决和命令补发。" />
                    <Border Style="{StaticResource CardGap}">
                        <StackPanel>
                            <TextBlock Text="考场参与状态" Style="{StaticResource CardHeading}" />
                            <TextBlock Text="按考试读取服务器上的参与记录，可按参与、考生或设备 ID 筛选。" Style="{StaticResource CardNote}" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="考试 ID" Style="{StaticResource FormLabel}"/>
                                    <TextBox Text="{Binding Monitoring.ExamId, UpdateSourceTrigger=PropertyChanged}" ToolTip="考试 ID"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                    <TextBlock Text="筛选" Style="{StaticResource FormLabel}"/>
                                    <TextBox Text="{Binding Monitoring.FilterText, UpdateSourceTrigger=PropertyChanged}" ToolTip="筛选参与/考生/设备 ID"/>
                                </StackPanel>
                                <CheckBox Grid.Column="2" Content="只看已交卷" IsChecked="{Binding Monitoring.OnlySubmitted}" Margin="0,0,16,9" VerticalAlignment="Bottom"/>
                                <Button Grid.Column="3" Content="从服务器刷新" Style="{StaticResource Btn.Primary}" MinWidth="108" VerticalAlignment="Bottom" Command="{Binding Monitoring.LoadCommand}"/>
                            </Grid>
                            <TextBlock Text="{Binding Monitoring.Status}" Style="{StaticResource CaptionText}" Margin="0,0,0,10"/>
                            <DataGrid ItemsSource="{Binding Monitoring.FilteredRows}" SelectedItem="{Binding Monitoring.SelectedRow}" Height="275">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="参与 ID" Binding="{Binding ParticipationId}" Width="*"/><DataGridTextColumn Header="考生 ID" Binding="{Binding CandidateId}" Width="*"/>
                                    <DataGridTextColumn Header="业务状态" Binding="{Binding BusinessState}" Width="100"/><DataGridTextColumn Header="授权设备" Binding="{Binding AuthorizedDeviceId}" Width="*"/>
                                    <DataGridTextColumn Header="entryVer" Binding="{Binding EntryVersion}" Width="85"/><DataGridTextColumn Header="authVer" Binding="{Binding AuthorizationVersion}" Width="85"/>
                                    <DataGridTextColumn Header="采集" Binding="{Binding CollectionState}" Width="90"/><DataGridTextColumn Header="连接" Binding="{Binding ConnectionState}" Width="110"/><DataGridTextColumn Header="当前题号" Binding="{Binding CurrentQuestion}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardGap}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="查询收齐事件" Style="{StaticResource ActionButton}" Margin="0" Command="{Binding Monitoring.RefreshCollectionEventsCommand}"/>
                                <StackPanel>
                                    <TextBlock Text="服务器收齐历史事件" Style="{StaticResource CardHeading}"/>
                                    <TextBlock Text="本页连接后每 20 秒定期补取，非实时推送。" Style="{StaticResource CardNote}" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="{Binding Monitoring.CollectionStatus}" Style="{StaticResource CaptionText}" Margin="0,0,0,8"/>
                            <DataGrid ItemsSource="{Binding Monitoring.CollectionEvents}" Height="145">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="事件 ID" Binding="{Binding EventId}" Width="*"/>
                                    <DataGridTextColumn Header="考试" Binding="{Binding ExamId}" Width="*"/>
                                    <DataGridTextColumn Header="名单版本" Binding="{Binding RosterVersion}" Width="100"/>
                                    <DataGridTextColumn Header="参与人数" Binding="{Binding ParticipantCount}" Width="100"/>
                                    <DataGridTextColumn Header="收齐时间" Binding="{Binding CompletedAt}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="设备裁决" Style="{StaticResource CardHeading}" />
                                <TextBlock Text="同一账号多端进入时，指定保留的唯一授权设备。" Style="{StaticResource CardNote}" />
                                <TextBlock Text="参与 ID" Style="{StaticResource FormLabel}"/>
                                <TextBox Style="{StaticResource FormTextBox}" Margin="0,0,0,12" Text="{Binding Monitoring.ParticipationId}" ToolTip="参与 ID"/>
                                <TextBlock Text="选择的设备 ID" Style="{StaticResource FormLabel}"/>
                                <TextBox Style="{StaticResource FormTextBox}" Margin="0,0,0,12" Text="{Binding Monitoring.SelectedDeviceId}" ToolTip="选择的设备 ID"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="预期 version" Style="{StaticResource FormLabel}"/>
                                        <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Monitoring.ExpectedVersionText}" ToolTip="预期 version"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="原因" Style="{StaticResource FormLabel}"/>
                                        <TextBox Style="{StaticResource FormTextBox}" Margin="0,0,0,12" Text="{Binding Monitoring.DecisionReason}" ToolTip="原因"/>
                                    </StackPanel>
                                </Grid>
                                <Button Content="确认设备裁决" Style="{StaticResource Btn.Danger}" HorizontalAlignment="Left" MinWidth="120" Padding="14,0" Command="{Binding Monitoring.DecideDeviceCommand}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="补发命令" Style="{StaticResource CardHeading}" />
                                <TextBlock Text="按原事件重发有效的开始或结束指令。" Style="{StaticResource CardNote}" />
                                <TextBlock Text="事件 ID" Style="{StaticResource FormLabel}"/>
                                <TextBox Style="{StaticResource FormTextBox}" Margin="0,0,0,12" Text="{Binding Monitoring.EventId}" ToolTip="事件 ID"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="参与 ID" Style="{StaticResource FormLabel}"/>
                                        <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Monitoring.ResendParticipationId}" ToolTip="参与 ID"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="设备 ID" Style="{StaticResource FormLabel}"/>
                                        <TextBox Style="{StaticResource FormTextBox}" Margin="0,0,0,12" Text="{Binding Monitoring.ResendDeviceId}" ToolTip="设备 ID"/>
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="entryVersion" Style="{StaticResource FormLabel}"/>
                                        <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Monitoring.EntryVersionText}" ToolTip="entryVersion"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="authorizationVersion" Style="{StaticResource FormLabel}"/>
                                        <TextBox Style="{StaticResource FormTextBox}" Margin="0,0,0,12" Text="{Binding Monitoring.AuthorizationVersionText}" ToolTip="authorizationVersion"/>
                                    </StackPanel>
                                </Grid>
                                <Button Content="补发" Style="{StaticResource Btn.Primary}" HorizontalAlignment="Left" MinWidth="96" Command="{Binding Monitoring.ResendCommand}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="清单静态预检" Tag="{StaticResource Icon.Checklist}">
            <ScrollViewer Style="{StaticResource PageScroller}">
                <StackPanel Style="{StaticResource PageBody}">
                    <HeaderedContentControl Style="{StaticResource PageHeading}" Header="清单静态预检" Tag="{StaticResource Icon.Checklist}"
                                    Content="对 D01 导入源 manifest.json 做静态预检（不是 D03 学生包清单），问题按 JSON Pointer 定位。" />
                    <Border Style="{StaticResource CardGap}">
                        <StackPanel>
                            <TextBlock Text="静态预检" Style="{StaticResource CardHeading}" />
                            <TextBlock Text="当前考试 ID 必须与清单中的 examId 完全一致。" Style="{StaticResource CardNote}" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition MaxWidth="420"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="当前考试 ID" Style="{StaticResource FormLabel}"/>
                                    <TextBox Text="{Binding ManifestPreflight.ExamId, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="必须与清单 examId 完全一致"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="选择 manifest.json 并静态预检" Style="{StaticResource Btn.Primary}" Padding="14,0"
                                        Command="{Binding ManifestPreflight.SelectManifestCommand}" VerticalAlignment="Bottom"/>
                            </Grid>
                            <TextBlock Text="{Binding ManifestPreflight.Status}" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionText}" Margin="0,0,0,12"/>
                            <DataGrid ItemsSource="{Binding ManifestPreflight.Issues}" Height="260"
                                      IsReadOnly="True" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="规则标识" Binding="{Binding Rule}" Width="2*"/>
                                    <DataGridTextColumn Header="JSON Pointer 位置" Binding="{Binding Location}" Width="2*"/>
                                    <DataGridTextColumn Header="问题说明" Binding="{Binding Message}" Width="3*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="能力边界" Style="{StaticResource CardHeading}" Margin="0,0,0,8"/>
                            <TextBlock Text="只读取不超过 10 MB、严格 UTF-8 的 manifest.json，并复用 D01 正式校验器。不会读取独立答案，不执行依赖检查、XeLaTeX 编译、正式计分、发布或客户端更新。"
                                       Style="{StaticResource BodyText}" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="成绩报表" Tag="{StaticResource Icon.Chart}" IsSelected="{Binding Reports.IsPageActive, Mode=TwoWay}">
            <reporting:ReportPageView DataContext="{Binding Reports}" />
        </TabItem>

        <TabItem Header="模块接入状态" Tag="{StaticResource Icon.Layers}">
            <ScrollViewer Style="{StaticResource PageScroller}">
                <StackPanel Style="{StaticResource PageBody}">
                    <HeaderedContentControl Style="{StaticResource PageHeading}" Header="模块接入状态" Tag="{StaticResource Icon.Layers}"
                                    Content="后续模块依赖审计：状态来自当前 Contracts 与 Server 的实际能力盘点，没有使用 Mock/Fake 数据。" />
                    <Border Style="{StaticResource Card}">
                        <DataGrid ItemsSource="{Binding Dependencies.Items}" Height="320" BorderThickness="0">
                            <DataGrid.Columns><DataGridTextColumn Header="模块" Binding="{Binding Module}" Width="180"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="130"/><DataGridTextColumn Header="原因与边界" Binding="{Binding Reason}" Width="*"/></DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
