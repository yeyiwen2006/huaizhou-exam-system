<Window x:Class="Exam.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="淮州考试系统 · 考务端" Width="1360" Height="860"
        MinWidth="1120" MinHeight="720"
        Background="{DynamicResource Brush.Background}"
        Closed="MainWindow_OnClosed">
    <Window.Resources>
        <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="FormTextBox" TargetType="TextBox" BasedOn="{StaticResource Tbx.Base}">
            <Setter Property="Margin" Value="0,0,10,8" />
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource Btn.Secondary}">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="MinWidth" Value="96" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="20">
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="服务器地址" Style="{StaticResource FormLabel}"/>
                    <TextBox Text="{Binding Connection.ServerAddress, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="考务身份" Style="{StaticResource FormLabel}"/>
                    <TextBox Text="{Binding Connection.OperatorId, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="访问令牌（仅内存）" Style="{StaticResource FormLabel}"/>
                    <PasswordBox Height="36" PasswordChanged="OperatorToken_OnPasswordChanged"/>
                </StackPanel>
                <Button Grid.Column="3" Content="连接服务器" Style="{StaticResource Btn.Primary}"
                        VerticalAlignment="Bottom" Margin="0,0,0,1" Command="{Binding Connection.ConnectCommand}"/>
                <TextBlock Grid.ColumnSpan="4" Margin="0,66,0,0" Text="{Binding Connection.Status}"
                           Style="{StaticResource CaptionText}"/>
            </Grid>
        </Border>

        <TabControl>
            <TabItem Header="C01 考试配置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="考试基础信息" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="考试 ID" Style="{StaticResource FormLabel}"/>
                                        <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Exam.ExamId, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="考试类别" Style="{StaticResource FormLabel}"/>
                                        <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Exam.CategoryName, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="考试名称（Windows 文件名规则）" Style="{StaticResource FormLabel}"/>
                                        <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Exam.Name, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="开始时间" Style="{StaticResource FormLabel}"/>
                                        <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Exam.ScheduledStartText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="结束时间" Style="{StaticResource FormLabel}"/>
                                        <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Exam.ScheduledEndText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                                <WrapPanel>
                                    <Button Content="新增科目" Style="{StaticResource ActionButton}" Command="{Binding Exam.AddSubjectCommand}"/>
                                    <Button Content="删除科目" Style="{StaticResource ActionButton}" Command="{Binding Exam.RemoveSubjectCommand}"/>
                                    <Button Content="校验并生成说明" Style="{StaticResource ActionButton}" Command="{Binding Exam.RefreshInstructionsCommand}"/>
                                    <Button Content="加载服务器计划" Style="{StaticResource ActionButton}" Command="{Binding Exam.LoadScheduleCommand}"/>
                                    <Button Content="保存计划到服务器" Style="{StaticResource Btn.Primary}" Margin="0,0,8,8" Command="{Binding Exam.SaveScheduleCommand}"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding Exam.ScheduleVersionText}" Style="{StaticResource CaptionText}"/>
                                <TextBlock Text="{Binding Exam.Status}" Style="{StaticResource CaptionText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="科目与题组（D01 scoring-rules schema）" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                                <DataGrid ItemsSource="{Binding Exam.Subjects}" SelectedItem="{Binding Exam.SelectedSubject}" IsReadOnly="False" Height="145" Margin="0,0,0,10">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="subjectId" Binding="{Binding SubjectId, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                        <DataGridTextColumn Header="科目名称" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                        <DataGridTextColumn Header="满分" Binding="{Binding MaxScore, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <WrapPanel>
                                    <Button Content="新增题组" Style="{StaticResource ActionButton}" Command="{Binding Exam.AddGroupCommand}"/>
                                    <Button Content="删除题组" Style="{StaticResource ActionButton}" Command="{Binding Exam.RemoveGroupCommand}"/>
                                </WrapPanel>
                                <DataGrid ItemsSource="{Binding Exam.SelectedSubject.Groups}" SelectedItem="{Binding Exam.SelectedSubject.SelectedGroup}"
                                          IsReadOnly="False" Height="245" HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="groupId" Binding="{Binding GroupId, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                                        <DataGridTextColumn Header="题组名" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                                        <DataGridTemplateColumn Header="type" Width="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                                                              ItemsSource="{Binding DataContext.Exam.QuestionTypes, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="顺序" Binding="{Binding Order, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                        <DataGridTextColumn Header="题量" Binding="{Binding QuestionCount, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                        <DataGridTextColumn Header="满分" Binding="{Binding MaxScore, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                        <DataGridCheckBoxColumn Header="允许不答" Binding="{Binding AllowAbstain}" Width="85"/>
                                        <DataGridTextColumn Header="one.correct" Binding="{Binding Correct}" Width="100"/>
                                        <DataGridTextColumn Header="one.blank" Binding="{Binding OneBlank}" Width="100"/>
                                        <DataGridTextColumn Header="one.wrong" Binding="{Binding OneWrong}" Width="100"/>
                                        <DataGridTextColumn Header="multi.all" Binding="{Binding AllCorrect}" Width="100"/>
                                        <DataGridTextColumn Header="multi.partial" Binding="{Binding PartialCorrect}" Width="110"/>
                                        <DataGridTextColumn Header="multi.blank" Binding="{Binding MultipleBlank}" Width="100"/>
                                        <DataGridTextColumn Header="multi.wrong" Binding="{Binding MultipleWrong}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0">
                                <StackPanel><TextBlock Text="校验结果" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Exam.ValidationSummary}" Style="{StaticResource BodyText}" Margin="0,8,0,0"/></StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,0">
                                <StackPanel><TextBlock Text="考生计分说明" Style="{StaticResource SectionTitle}"/><TextBox Text="{Binding Exam.InstructionsText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="150" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"/></StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="C02 考生名册">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="手工录入与 Excel 导入" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"><TextBlock Text="姓名" Style="{StaticResource FormLabel}"/><TextBox Style="{StaticResource FormTextBox}" Text="{Binding Roster.Name, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="班级（纯数字文本）" Style="{StaticResource FormLabel}"/><TextBox Style="{StaticResource FormTextBox}" Text="{Binding Roster.ClassText, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="准考证号（纯数字文本）" Style="{StaticResource FormLabel}"/><TextBox Style="{StaticResource FormTextBox}" Text="{Binding Roster.AdmissionNo, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                    <Button Grid.Column="3" Content="加入名册" Style="{StaticResource Btn.Primary}" VerticalAlignment="Bottom" Margin="0,0,0,8" Command="{Binding Roster.AddManualCommand}"/>
                                </Grid>
                                <WrapPanel>
                                    <Button Content="下载 Excel 模板" Style="{StaticResource ActionButton}" Command="{Binding Roster.CreateTemplateCommand}"/>
                                    <Button Content="选择文件并预览" Style="{StaticResource ActionButton}" Command="{Binding Roster.ImportPreviewCommand}"/>
                                    <Button Content="确认整体导入" Style="{StaticResource Btn.Primary}" Margin="0,0,8,8" Command="{Binding Roster.ConfirmImportCommand}"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding Roster.Status}" Style="{StaticResource CaptionText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="导入预览（任一错误都会阻止整批导入）" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <DataGrid ItemsSource="{Binding Roster.PreviewRows}" Height="220">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="行" Binding="{Binding RowNumber}" Width="60"/><DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="班级" Binding="{Binding ClassText}" Width="*"/><DataGridTextColumn Header="准考证号" Binding="{Binding AdmissionNo}" Width="*"/>
                                        <DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="100"/><DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="2*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="本进程名册草稿（关闭即丢失，未写入服务器）" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <DataGrid ItemsSource="{Binding Roster.Entries}" Height="220">
                                    <DataGrid.Columns><DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="班级" Binding="{Binding ClassText}" Width="*"/><DataGridTextColumn Header="准考证号" Binding="{Binding AdmissionNo}" Width="*"/></DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="C03 激活与房间组">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="房间组内存草稿（非服务器分组）" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="新增" Style="{StaticResource Btn.Primary}" Command="{Binding Activation.AddGroupCommand}"/>
                                    <Button DockPanel.Dock="Right" Content="删除空组" Style="{StaticResource Btn.Danger}" Margin="8,0" Command="{Binding Activation.RemoveGroupCommand}"/>
                                    <TextBox Text="{Binding Activation.NewGroupName, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                                <DockPanel Margin="0,8,0,0">
                                    <Button DockPanel.Dock="Right" Content="重命名草稿" Style="{StaticResource Btn.Secondary}" Command="{Binding Activation.RenameGroupCommand}"/>
                                    <TextBox Text="{Binding Activation.SelectedGroupName, UpdateSourceTrigger=PropertyChanged}" ToolTip="选中草稿的新名称"/>
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding Activation.Groups}" SelectedItem="{Binding Activation.SelectedGroup}" Height="145" Margin="0,10,0,0">
                                    <DataGrid.Columns><DataGridTextColumn Header="房间组 ID" Binding="{Binding RoomGroupId}" Width="2*"/><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/></DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="设备激活审批 / 查询" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"><TextBlock Text="激活申请 ID" Style="{StaticResource FormLabel}"/><TextBox Style="{StaticResource FormTextBox}" Text="{Binding Activation.ActivationRequestId, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                    <StackPanel Grid.Column="1"><TextBlock Text="房间组 ID（可空）" Style="{StaticResource FormLabel}"/><TextBox Style="{StaticResource FormTextBox}" Text="{Binding Activation.ApprovalRoomGroupId, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                    <Button Grid.Column="2" Content="审批" Style="{StaticResource Btn.Primary}" VerticalAlignment="Bottom" Margin="0,0,14,8" Command="{Binding Activation.ApproveCommand}"/>
                                    <StackPanel Grid.Column="3"><TextBlock Text="设备 ID" Style="{StaticResource FormLabel}"/><TextBox Style="{StaticResource FormTextBox}" Text="{Binding Activation.QueryDeviceId, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                    <Button Grid.Column="4" Content="查询设备" Style="{StaticResource Btn.Secondary}" VerticalAlignment="Bottom" Margin="0,0,0,8" Command="{Binding Activation.QueryDeviceCommand}"/>
                                </Grid>
                                <TextBlock Text="{Binding Activation.Status}" Style="{StaticResource CaptionText}" Margin="0,0,0,10"/>
                                <DataGrid ItemsSource="{Binding Activation.Devices}" Height="260">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="设备 ID" Binding="{Binding DeviceId}" Width="*"/><DataGridTextColumn Header="客户端编号" Binding="{Binding ClientNumber}" Width="120"/>
                                        <DataGridTextColumn Header="激活状态" Binding="{Binding ActivationStatus}" Width="110"/><DataGridTextColumn Header="房间组" Binding="{Binding RoomGroupId}" Width="*"/>
                                        <DataGridTextColumn Header="当前考生" Binding="{Binding Candidate}" Width="120"/><DataGridTextColumn Header="连接状态" Binding="{Binding ConnectionStatus}" Width="120"/><DataGridTextColumn Header="最后心跳" Binding="{Binding LastSeen}" Width="120"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="C04 监控与处置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="考场参与状态" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="从服务器刷新" Style="{StaticResource Btn.Primary}" Command="{Binding Monitoring.LoadCommand}"/>
                                    <CheckBox DockPanel.Dock="Right" Content="只看已交卷" IsChecked="{Binding Monitoring.OnlySubmitted}" Margin="14,0" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding Monitoring.FilterText, UpdateSourceTrigger=PropertyChanged}" Margin="8,0" ToolTip="筛选参与/考生/设备 ID"/>
                                    <TextBox Width="220" Text="{Binding Monitoring.ExamId, UpdateSourceTrigger=PropertyChanged}" ToolTip="考试 ID"/>
                                </DockPanel>
                                <TextBlock Text="{Binding Monitoring.Status}" Style="{StaticResource CaptionText}" Margin="0,0,0,10"/>
                                <DataGrid ItemsSource="{Binding Monitoring.FilteredRows}" SelectedItem="{Binding Monitoring.SelectedRow}" Height="275">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="参与 ID" Binding="{Binding ParticipationId}" Width="*"/><DataGridTextColumn Header="考生 ID" Binding="{Binding CandidateId}" Width="*"/>
                                        <DataGridTextColumn Header="业务状态" Binding="{Binding BusinessState}" Width="100"/><DataGridTextColumn Header="授权设备" Binding="{Binding AuthorizedDeviceId}" Width="*"/>
                                        <DataGridTextColumn Header="entryVer" Binding="{Binding EntryVersion}" Width="85"/><DataGridTextColumn Header="authVer" Binding="{Binding AuthorizationVersion}" Width="85"/>
                                        <DataGridTextColumn Header="采集" Binding="{Binding CollectionState}" Width="90"/><DataGridTextColumn Header="连接" Binding="{Binding ConnectionState}" Width="110"/><DataGridTextColumn Header="当前题号" Binding="{Binding CurrentQuestion}" Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="服务器收齐事件（手动查询）" Style="{StaticResource SectionTitle}"/>
                                <Button Content="查询收齐事件" Style="{StaticResource ActionButton}" Command="{Binding Monitoring.RefreshCollectionEventsCommand}" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding Monitoring.CollectionStatus}" Style="{StaticResource CaptionText}" Margin="0,0,0,8"/>
                                <DataGrid ItemsSource="{Binding Monitoring.CollectionEvents}" Height="145">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="事件 ID" Binding="{Binding EventId}" Width="*"/>
                                        <DataGridTextColumn Header="考试" Binding="{Binding ExamId}" Width="*"/>
                                        <DataGridTextColumn Header="名单版本" Binding="{Binding RosterVersion}" Width="100"/>
                                        <DataGridTextColumn Header="参与人数" Binding="{Binding ParticipantCount}" Width="100"/>
                                        <DataGridTextColumn Header="收齐时间" Binding="{Binding CompletedAt}" Width="2*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="设备裁决" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Monitoring.ParticipationId}" ToolTip="参与 ID"/>
                                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Monitoring.SelectedDeviceId}" ToolTip="选择的设备 ID"/>
                                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Monitoring.ExpectedVersionText}" ToolTip="预期 version"/>
                                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Monitoring.DecisionReason}" ToolTip="原因"/>
                                    <Button Content="确认设备裁决" Style="{StaticResource Btn.Danger}" Command="{Binding Monitoring.DecideDeviceCommand}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="补发命令" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Monitoring.EventId}" ToolTip="事件 ID"/>
                                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Monitoring.ResendParticipationId}" ToolTip="参与 ID"/>
                                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Monitoring.ResendDeviceId}" ToolTip="设备 ID"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox Grid.Column="0" Style="{StaticResource FormTextBox}" Text="{Binding Monitoring.EntryVersionText}" ToolTip="entryVersion"/><TextBox Grid.Column="1" Style="{StaticResource FormTextBox}" Text="{Binding Monitoring.AuthorizationVersionText}" ToolTip="authorizationVersion"/></Grid>
                                    <Button Content="补发" Style="{StaticResource Btn.Primary}" Command="{Binding Monitoring.ResendCommand}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="C05 导入与修订">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="考试版本与客户端更新" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Content="查询正式版本" Style="{StaticResource Btn.Primary}" Command="{Binding ImportRevision.LoadVersionCommand}"/>
                                    <TextBox Text="{Binding ImportRevision.ExamId, UpdateSourceTrigger=PropertyChanged}" ToolTip="考试 ID"/>
                                </DockPanel>
                                <TextBlock Text="{Binding ImportRevision.Status}" Style="{StaticResource CaptionText}" Margin="0,0,0,10"/>
                                <WrapPanel Margin="0,0,0,10">
                                    <TextBlock Text="计划版本：" Style="{StaticResource BodyText}"/><TextBlock Text="{Binding ImportRevision.ScheduleVersion}" Style="{StaticResource BodyText}" Margin="0,0,24,0"/>
                                    <TextBlock Text="题包版本：" Style="{StaticResource BodyText}"/><TextBlock Text="{Binding ImportRevision.PaperVersion}" Style="{StaticResource BodyText}" Margin="0,0,24,0"/>
                                    <TextBlock Text="计分版本：" Style="{StaticResource BodyText}"/><TextBlock Text="{Binding ImportRevision.GradingVersion}" Style="{StaticResource BodyText}"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding ImportRevision.PublicationState}" Style="{StaticResource BodyText}" Margin="0,0,0,10"/>
                                <DataGrid ItemsSource="{Binding ImportRevision.ParticipantUpdates}" Height="240">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="参试者 ID" Binding="{Binding ParticipantId}" Width="*"/>
                                        <DataGridTextColumn Header="业务状态" Binding="{Binding ExamState}" Width="110"/>
                                        <DataGridTextColumn Header="目标题包版本" Binding="{Binding TargetPaperVersion}" Width="130"/>
                                        <DataGridTextColumn Header="已安装版本" Binding="{Binding InstalledPaperVersion}" Width="110"/>
                                        <DataGridTextColumn Header="更新状态" Binding="{Binding PaperUpdateState}" Width="130"/>
                                        <DataGridTextColumn Header="最近错误" Binding="{Binding LastError}" Width="2*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="逐题导入与考试中修订" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <TextBlock Text="修改原因草稿" Style="{StaticResource FormLabel}"/>
                                <TextBox Text="{Binding ImportRevision.ChangeReason, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <Button Content="逐题导入：接口未提供" IsEnabled="False" Margin="0,0,8,0"/>
                                    <Button Content="预览：接口未提供" IsEnabled="False" Margin="0,0,8,0"/>
                                    <Button Content="发布修订：接口未提供" IsEnabled="False"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="C06 报告与服务">
                <Border Style="{StaticResource Card}" Margin="14">
                    <StackPanel>
                        <TextBlock Text="五类正式报表" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                        <ComboBox ItemsSource="{Binding Reports.ReportTypes}" SelectedItem="{Binding Reports.SelectedReport}" Width="320" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding Reports.AvailabilityText}" Style="{StaticResource BodyText}" Margin="0,0,0,14"/>
                        <TextBlock Text="报告未生成、考试未结束、答卷未收齐、重算中、报告可用是独立状态；正式状态须由服务器报告 API 返回。" Style="{StaticResource CaptionText}" Margin="0,0,0,14"/>
                        <WrapPanel Margin="0,0,0,14">
                            <Button Content="读取报告：接口未提供" IsEnabled="False" Margin="0,0,8,0"/>
                            <Button Content="Excel 正式导出：接口未提供" IsEnabled="False"/>
                        </WrapPanel>
                        <TextBlock Text="服务管理" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                        <TextBlock Text="服务启动、停止及运行指标缺少 GUI/CLI 共用的正式操作入口。" Style="{StaticResource CaptionText}"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="C07 主备管理">
                <Border Style="{StaticResource Card}" Margin="14">
                    <StackPanel>
                        <TextBlock Text="主备与保护状态" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="主节点" Style="{StaticResource FormLabel}"/><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding HighAvailability.ActiveNode}" Style="{StaticResource BodyText}"/>
                            <TextBlock Grid.Row="1" Text="备节点" Style="{StaticResource FormLabel}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HighAvailability.StandbyNode}" Style="{StaticResource BodyText}"/>
                            <TextBlock Grid.Row="2" Text="复制状态" Style="{StaticResource FormLabel}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding HighAvailability.ReplicationState}" Style="{StaticResource BodyText}"/>
                            <TextBlock Grid.Row="3" Text="保护模式" Style="{StaticResource FormLabel}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding HighAvailability.ProtectionMode}" Style="{StaticResource BodyText}"/>
                            <TextBlock Grid.Row="4" Text="备份状态" Style="{StaticResource FormLabel}"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding HighAvailability.BackupState}" Style="{StaticResource BodyText}"/>
                            <TextBlock Grid.Row="5" Text="隔离检查" Style="{StaticResource FormLabel}"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding HighAvailability.IsolationCheck}" Style="{StaticResource BodyText}"/>
                        </Grid>
                        <TextBlock Text="{Binding HighAvailability.OperationStatus}" Style="{StaticResource CaptionText}" Margin="0,0,0,14"/>
                        <WrapPanel>
                            <Button Content="隔离检查：接口未提供" IsEnabled="False" Margin="0,0,8,8"/>
                            <Button Content="接管：接口未提供" IsEnabled="False" Margin="0,0,8,8"/>
                            <Button Content="单机应急：接口未提供" IsEnabled="False" Margin="0,0,8,8"/>
                            <Button Content="重建备机：接口未提供" IsEnabled="False" Margin="0,0,8,8"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="C05–C07 依赖状态">
                <Border Style="{StaticResource Card}" Margin="14">
                    <StackPanel>
                        <TextBlock Text="后续模块依赖审计" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                        <TextBlock Text="状态来自当前 Contracts 与 Server 的实际能力盘点；没有使用 Mock/Fake 数据。" Style="{StaticResource CaptionText}" Margin="0,0,0,12"/>
                        <DataGrid ItemsSource="{Binding Dependencies.Items}" Height="320">
                            <DataGrid.Columns><DataGridTextColumn Header="模块" Binding="{Binding Module}" Width="180"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="130"/><DataGridTextColumn Header="原因与边界" Binding="{Binding Reason}" Width="*"/></DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
