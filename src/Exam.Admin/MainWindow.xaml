                                    <DataGridTextColumn Header="选项" Binding="{Binding Options}" Width="Auto" MinWidth="110" MaxWidth="170" ElementStyle="{StaticResource ImportPreviewCell}"/>
                                    <DataGridTextColumn Header="参考答案" Binding="{Binding CorrectOptions}" Width="Auto" MinWidth="86" MaxWidth="150" ElementStyle="{StaticResource ImportPreviewCell}"/>
                                    <DataGridTextColumn Header="PDF 页数" Binding="{Binding PageCount}" Width="Auto" MinWidth="82"/>
                                    <DataGridTextColumn Header="选项绑定页" Binding="{Binding RegionPages}" Width="*" MinWidth="210" ElementStyle="{StaticResource ImportPreviewCell}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel>
                                <Button Content="打开选中题目 PDF" Style="{StaticResource ActionButton}" Command="{Binding Import.OpenQuestionCommand}"/>
                                <Button Content="确认并正式发布" Style="{StaticResource PrimaryAction}" Command="{Binding Import.PublishCommand}"/>
                            </WrapPanel>
                            <TextBlock Text="发布成功仅表示服务器整套试卷与答案规则已生效，不代表所有学生端均已更新。"
