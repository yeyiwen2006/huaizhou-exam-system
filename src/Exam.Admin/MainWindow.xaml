                                <Button Content="检查并预览规则" Style="{StaticResource ActionButton}" Command="{Binding GradingRevision.CheckCommand}"/>
                                <Button Content="确认发布 / 重试原请求" Style="{StaticResource PrimaryAction}" Command="{Binding GradingRevision.PublishCommand}"/>
                                <Button Content="刷新重算状态" Style="{StaticResource ActionButton}" Command="{Binding GradingRevision.RefreshStatusCommand}"/>
                            </WrapPanel>
                            <DataGrid ItemsSource="{Binding GradingRevision.Questions}" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" MinHeight="100" MaxHeight="300" Margin="0,8,0,8">
