<Window x:Class="Exam.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:reporting="clr-namespace:Exam.Admin.Reporting"
        xmlns:controls="clr-namespace:Exam.Desktop.Shared.Controls;assembly=Exam.Desktop.Shared"
        Title="怀籀传承在线考试系统 · 考务端" Width="1440" Height="900"
        MinWidth="1120" MinHeight="720"
        Background="{DynamicResource Brush.Background}"
        FontFamily="{DynamicResource Font.Family}"
        UseLayoutRounding="True"
        Closed="MainWindow_OnClosed">
    <Window.Resources>
        <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}" />
        <Style x:Key="FormTextBox" TargetType="TextBox" BasedOn="{StaticResource Tbx.Base}">
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource Btn.Secondary}">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="14,0" />
        </Style>
        <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="14,0" />
        </Style>
        <Style x:Key="PageScroller" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style x:Key="PageBody" TargetType="StackPanel">
            <Setter Property="Margin" Value="{StaticResource Padding.Page}" />
        </Style>
        <Style x:Key="CardGap" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="CardHeading" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="CardNote" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="StatusLine" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <!-- 页头：图标块 + 页面标题（Header）+ 用途说明（Content）；图标几何放在 Tag -->
        <Style x:Key="PageHeading" TargetType="HeaderedContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,0,0,20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="HeaderedContentControl">
                        <DockPanel>
                            <Border Style="{StaticResource IconTile}" Width="44" Height="44" CornerRadius="11">
                                <Path Style="{StaticResource IconTile.Glyph}" Width="22" Height="22"
                                      Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource PageTitle}"
                                           Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" />
                                <TextBlock Style="{StaticResource PageSubtitle}"
                                           Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                            </StackPanel>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <controls:Banner Grid.Row="0" Level="Warning" Margin="12,8,12,4" Padding="12"
                         DataContext="{Binding Management, RelativeSource={RelativeSource AncestorType=Window}}"
                         IsOpen="{Binding ShowProtectionWarning}" Message="{Binding ProtectionText}"/>
        <Grid Grid.Row="1">
        <!-- 登录页（未登录时显示，覆盖整个窗口区域） -->
        <ContentControl x:Name="PageRegion" />

        <!-- 主界面（登录后显示） -->
        <TabControl x:Name="MainTabArea"
                    Style="{StaticResource Nav.TabControl}" Tag="考务端"
                    SelectedIndex="{Binding SelectedPage, Mode=TwoWay}"
                    SelectionChanged="OnSelectedPageChanged">
        <controls:NavShell.TopBar>
            <!-- 已登录状态栏：账号信息 + 退出登录 + 服务器状态 + 当前考试条。 -->
            <Border Style="{StaticResource TopBar}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="退出登录" Style="{StaticResource Btn.Secondary}" MinWidth="96" Padding="14,0"
                                Command="{Binding Connection.LogoutCommand}" />
                        <Button DockPanel.Dock="Right" Content="本机服务管理" Style="{StaticResource Btn.Secondary}"
                                Margin="0,0,8,0" Click="OnManagementRequested" />
                        <Border Style="{StaticResource IconTile}" Width="36" Height="36" CornerRadius="9" Margin="0,0,12,0">
                            <Path Style="{StaticResource IconTile.Glyph}" Data="{StaticResource Icon.Users}" Width="18" Height="18" />
                        </Border>
                        <TextBlock Text="{Binding Connection.AccountTitle}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <Path Data="{StaticResource Icon.Server}" Style="{StaticResource IconTile.Glyph}" Width="13" Height="13"
                              Stroke="{DynamicResource Brush.Text.Secondary}" StrokeThickness="1.5" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Connection.Status}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- 当前考试：进入某场考试或新建考试时显示，不在主页显示。 -->
                    <Border Grid.Row="2" Margin="-28,12,-28,-12" Padding="28,10"
                            Background="{DynamicResource Brush.Primary.Soft}"
                            Visibility="{Binding ShowCurrentExamBar, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="返回全部考试" Style="{StaticResource Btn.Secondary}" Padding="14,0"
                                    Command="{Binding BackToHomeCommand}"/>
                            <TextBlock Text="当前考试" Style="{StaticResource FieldLabel}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentExamTitle}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </controls:NavShell.TopBar>

        <!-- 主页：全部考试以卡片列出，按名称区分；点击卡片进入该场考试，或新建考试。 -->
        <TabItem Header="全部考试" Tag="{StaticResource Icon.Layers}">
            <ScrollViewer Style="{StaticResource PageScroller}">
                <StackPanel Style="{StaticResource PageBody}">
                    <DockPanel Margin="0,0,0,20">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="刷新" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Command="{Binding Home.RefreshCommand}"/>
                            <Button Content="新建考试" Style="{StaticResource PrimaryAction}" Margin="0" Command="{Binding Home.NewExamCommand}"/>
                        </StackPanel>
                        <HeaderedContentControl Style="{StaticResource PageHeading}" Header="全部考试" Tag="{StaticResource Icon.Layers}" Margin="0"
                                                Content="点击考试进入设置、监控和成绩统计，或新建考试。" />
                    </DockPanel>
                    <TextBlock Text="{Binding Home.Status}" Style="{StaticResource CaptionText}" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding Home.Exams}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding OpenCommand}" Height="Auto" Margin="0,0,0,12" Padding="0" Cursor="Hand"
                                        HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Name}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Card" Style="{StaticResource Card}" Padding="20,18">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Focus.Ring}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <!-- 一行一场考试；名称自动换行，完整显示。 -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}" Width="44" Height="44" CornerRadius="11" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <Path Style="{StaticResource IconTile.Glyph}" Data="{StaticResource Icon.Document}" Width="22" Height="22" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding TimeText}" Style="{StaticResource BodyText}" Margin="0,6,0,0"/>
                                            <TextBlock Text="{Binding ParticipantsText}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                            <controls:StatusPill Text="{Binding StateText}" Level="{Binding StateLevel}" Margin="0,0,8,0"/>
                                            <controls:StatusPill Text="{Binding VisibilityText}" Level="{Binding VisibilityLevel}"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="考试设置" Tag="{StaticResource Icon.Calendar}" IsEnabled="{Binding CanEditSettings}">
            <ScrollViewer Style="{StaticResource PageScroller}">
                <StackPanel Style="{StaticResource PageBody}">
                    <HeaderedContentControl Style="{StaticResource PageHeading}" Header="{Binding Exam.Heading}" Tag="{StaticResource Icon.Calendar}"
                                    Content="填写考试名称、起止时间、科目与题组计分规则，保存到服务器后由此生成学生端的考试说明。" />
                    <Border Style="{StaticResource CardGap}">
                        <StackPanel>
                            <TextBlock Text="考试基础信息" Style="{StaticResource CardHeading}" />
                            <TextBlock Text="考试名称会用作试题文件名的开头，不能包含 \ / : * ? &quot; &lt; &gt; | 等字符；时间按“年-月-日 时:分”填写。" Style="{StaticResource CardNote}" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="考试名称" Style="{StaticResource FormLabel}"/>
                                    <TextBox Style="{StaticResource FormTextBox}" IsEnabled="{Binding Exam.IsSettingsEditable}"
                                             Text="{Binding Exam.Name, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="开始时间" Style="{StaticResource FormLabel}"/>
                                    <TextBox Style="{StaticResource FormTextBox}" IsEnabled="{Binding Exam.CanEditTime}" Text="{Binding Exam.ScheduledStartText, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="结束时间" Style="{StaticResource FormLabel}"/>
                                    <TextBox Style="{StaticResource FormTextBox}" Margin="0,0,0,12" IsEnabled="{Binding Exam.CanEditTime}" Text="{Binding Exam.ScheduledEndText, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,4,0,14" />
                            <WrapPanel>
                                <Button Content="校验并生成说明" Style="{StaticResource ActionButton}" Command="{Binding Exam.RefreshInstructionsCommand}"/>
                                <Button Content="保存考试设置" Style="{StaticResource PrimaryAction}" Command="{Binding Exam.SaveCommand}"/>
                                <Button Content="重新读取当前考试" Style="{StaticResource ActionButton}" Command="{Binding Exam.ReloadCommand}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding Exam.Status}" Style="{StaticResource StatusLine}"/>
                        </StackPanel>
                    </Border>
                    <!-- 学生端显示：随时可改；有考生确认参试后，全部答卷回收前不能取消显示。 -->
                    <Border Style="{StaticResource CardGap}">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Content="在学生端显示本场考试" VerticalAlignment="Center"
                                      IsChecked="{Binding Exam.VisibleToStudents, Mode=TwoWay}" IsEnabled="{Binding Exam.CanChangeVisibility}"/>
                            <StackPanel>
                                <TextBlock Text="学生端显示" Style="{StaticResource CardHeading}" />
                                <TextBlock Text="{Binding Exam.VisibilityNote}" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource CardGap}">
                        <StackPanel>
                            <TextBlock Text="科目与题组" Style="{StaticResource CardHeading}" />
                            <TextBlock Text="先在上表选中一个科目，再在下表编辑它的题组和计分规则。" Style="{StaticResource CardNote}" />
                            <DataGrid ItemsSource="{Binding Exam.Subjects}" SelectedItem="{Binding Exam.SelectedSubject}" IsEnabled="{Binding Exam.IsSettingsEditable}" IsReadOnly="False" Height="145" Margin="0,0,0,6">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Visibility="Collapsed" IsReadOnly="True" Header="科目编号" Binding="{Binding SubjectId, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridTextColumn Header="科目名称" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridTextColumn Header="满分" Binding="{Binding MaxScore, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel Margin="0,0,0,14">
                                <Button Content="新增科目" Style="{StaticResource ActionButton}" Command="{Binding Exam.AddSubjectCommand}"/>
                                <Button Content="删除科目" Style="{StaticResource ActionButton}" Command="{Binding Exam.RemoveSubjectCommand}"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,6">
                                <Button Content="新增题组" Style="{StaticResource ActionButton}" Command="{Binding Exam.AddGroupCommand}"/>
                                <Button Content="删除题组" Style="{StaticResource ActionButton}" Command="{Binding Exam.RemoveGroupCommand}"/>
                            </WrapPanel>
                            <DataGrid ItemsSource="{Binding Exam.SelectedSubject.Groups}" SelectedItem="{Binding Exam.SelectedSubject.SelectedGroup}"
                                      IsEnabled="{Binding Exam.IsSettingsEditable}" IsReadOnly="False" Height="245" HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Visibility="Collapsed" IsReadOnly="True" Header="题组编号" Binding="{Binding GroupId, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                                    <DataGridTextColumn Header="题组名" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                                    <DataGridTemplateColumn Header="题型" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox SelectedValue="{Binding Type, UpdateSourceTrigger=PropertyChanged}" MinHeight="28"
                                                          SelectedValuePath="Value" DisplayMemberPath="Label"
                                                          ItemsSource="{Binding DataContext.Exam.QuestionTypes, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="顺序" Binding="{Binding Order, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                    <DataGridTextColumn Header="题量" Binding="{Binding QuestionCount, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                    <DataGridTextColumn Header="满分" Binding="{Binding MaxScore, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                    <DataGridCheckBoxColumn Header="允许不答" Binding="{Binding AllowAbstain}" Width="85"/>
                                    <DataGridTextColumn Header="单答案·选对" Binding="{Binding Correct}" Width="100"/>
                                    <DataGridTextColumn Header="单答案·不选" Binding="{Binding OneBlank}" Width="100"/>
                                    <DataGridTextColumn Header="单答案·选错" Binding="{Binding OneWrong}" Width="100"/>
                                    <DataGridTextColumn Header="多答案·全对" Binding="{Binding AllCorrect}" Width="100"/>
                                    <DataGridTextColumn Header="多答案·对但不全" Binding="{Binding PartialCorrect}" Width="110"/>
                                    <DataGridTextColumn Header="多答案·不选" Binding="{Binding MultipleBlank}" Width="100"/>
                                    <DataGridTextColumn Header="多答案·选错" Binding="{Binding MultipleWrong}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="校验结果" Style="{StaticResource CardHeading}"/>
                                <Border Style="{StaticResource Hint}" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding Exam.ValidationSummary}" Style="{StaticResource BodyText}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="考生计分说明" Style="{StaticResource CardHeading}"/>
                                <TextBox Text="{Binding Exam.InstructionsText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                         Height="150" Margin="0,10,0,0" Padding="10,8" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="考生名单" Tag="{StaticResource Icon.Users}" IsEnabled="{Binding HasCurrentExam}">
            <ScrollViewer Style="{StaticResource PageScroller}">
                <StackPanel Style="{StaticResource PageBody}">
                    <HeaderedContentControl Style="{StaticResource PageHeading}" Header="考生名单" Tag="{StaticResource Icon.Users}"
                                    Content="手工录入或从 Excel 整体导入考生；任一行有错误都会阻止整批导入。" />
                    <Border Style="{StaticResource CardGap}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="重新读取名册" Style="{StaticResource ActionButton}" Command="{Binding Roster.RefreshCommand}"/>
                                <TextBlock Text="手工录入与 Excel 导入" Style="{StaticResource CardHeading}" />
                            </DockPanel>
                            <TextBlock Text="班级与准考证号均为纯数字文本，保留前导零。" Style="{StaticResource CardNote}" />
                            <Grid IsEnabled="{Binding Roster.CanEdit}">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Text="姓名" Style="{StaticResource FormLabel}"/><TextBox Style="{StaticResource FormTextBox}" Text="{Binding Roster.Name, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="班级" Style="{StaticResource FormLabel}"/><TextBox Style="{StaticResource FormTextBox}" Text="{Binding Roster.ClassText, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="准考证号" Style="{StaticResource FormLabel}"/><TextBox Style="{StaticResource FormTextBox}" Text="{Binding Roster.AdmissionNo, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <Button Grid.Column="3" Content="加入名单" Style="{StaticResource Btn.Primary}" MinWidth="96" VerticalAlignment="Bottom" Margin="0,0,0,12" Command="{Binding Roster.AddManualCommand}"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,2,0,14" />
                            <WrapPanel>
                                <Button Content="下载 Excel 模板" Style="{StaticResource ActionButton}" Command="{Binding Roster.CreateTemplateCommand}"/>
                                <Button Content="选择文件并预览" Style="{StaticResource ActionButton}" Command="{Binding Roster.ImportPreviewCommand}"/>
                                <Button Content="确认整体导入" Style="{StaticResource PrimaryAction}" Command="{Binding Roster.ConfirmImportCommand}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding Roster.Status}" Style="{StaticResource StatusLine}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardGap}">
                        <StackPanel>
                            <TextBlock Text="导入预览" Style="{StaticResource CardHeading}" />
                            <TextBlock Text="任一错误都会阻止整批导入；修正 Excel 后重新预览。" Style="{StaticResource CardNote}" />
                            <DataGrid ItemsSource="{Binding Roster.PreviewRows}" Height="220">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="行" Binding="{Binding RowNumber}" Width="60"/><DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="班级" Binding="{Binding ClassText}" Width="*"/><DataGridTextColumn Header="准考证号" Binding="{Binding AdmissionNo}" Width="*"/>
                                    <DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="100"/><DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="已录入的考生" Style="{StaticResource CardHeading}" />
                            <TextBlock Text="以下记录来自当前考试的服务器名册。选中考生后可在上方修改未使用的身份；已准备入场或参试的记录不可删除或更换。" Style="{StaticResource CardNote}" />
                            <WrapPanel Margin="0,0,0,8">
                                <Button Content="保存选中考生的修改" Style="{StaticResource ActionButton}" Command="{Binding Roster.UpdateSelectedCommand}"/>
                                <Button Content="删除选中考生" Style="{StaticResource ActionButton}" Command="{Binding Roster.DeleteSelectedCommand}"/>
                            </WrapPanel>
                            <DataGrid ItemsSource="{Binding Roster.Entries}" SelectedItem="{Binding Roster.SelectedEntry}" Height="220">
                                <DataGrid.Columns><DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="班级" Binding="{Binding ClassText}" Width="*"/><DataGridTextColumn Header="准考证号" Binding="{Binding AdmissionNo}" Width="*"/></DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>


        <TabItem Header="设备监控" Tag="{StaticResource Icon.Monitor}" IsEnabled="{Binding HasCurrentExam}" IsSelected="{Binding Monitoring.IsPageActive, Mode=TwoWay}">
            <ScrollViewer Style="{StaticResource PageScroller}">
                <StackPanel Style="{StaticResource PageBody}">
                    <HeaderedContentControl Style="{StaticResource PageHeading}" Header="设备监控" Tag="{StaticResource Icon.Monitor}"
                                    Content="查看考生参试和答卷回收情况，处理同一考生多台设备的冲突，以及重发考试指令。" />
                    <Border Style="{StaticResource CardGap}">
                        <StackPanel>
                            <TextBlock Text="考生参试情况" Style="{StaticResource CardHeading}" />
                            <TextBlock Text="读取所选考试的实际参试考生，可按考生或设备筛选。" Style="{StaticResource CardNote}" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="0"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                    <TextBlock Text="筛选" Style="{StaticResource FormLabel}"/>
                                    <TextBox Text="{Binding Monitoring.FilterText, UpdateSourceTrigger=PropertyChanged}" ToolTip="输入考生或设备的部分内容进行筛选"/>
                                </StackPanel>
                                <CheckBox Grid.Column="2" Content="只看已交卷" IsChecked="{Binding Monitoring.OnlySubmitted}" Margin="0,0,16,9" VerticalAlignment="Bottom"/>
                                <Button Grid.Column="3" Content="刷新" Style="{StaticResource Btn.Primary}" MinWidth="108" VerticalAlignment="Bottom" Command="{Binding Monitoring.LoadCommand}"/>
                            </Grid>
                            <TextBlock Text="{Binding Monitoring.Status}" Style="{StaticResource CaptionText}" Margin="0,0,0,10"/>
                            <DataGrid ItemsSource="{Binding Monitoring.FilteredRows}" SelectedItem="{Binding Monitoring.SelectedRow}" Height="275">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="参试记录" Binding="{Binding ParticipationId}" Width="*"/><DataGridTextColumn Header="考生" Binding="{Binding CandidateId}" Width="*"/>
                                    <DataGridTextColumn Header="业务状态" Binding="{Binding BusinessState}" Width="100"/><DataGridTextColumn Header="答题设备" Binding="{Binding AuthorizedDeviceId}" Width="*"/>

                                    <DataGridTextColumn Header="答卷" Binding="{Binding CollectionState}" Width="90"/><DataGridTextColumn Header="失焦情况" Binding="{Binding FocusSummary}" Width="130"/><DataGridTextColumn Header="修订复核" Binding="{Binding PaperReviewState}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardGap}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="查询收齐记录" Style="{StaticResource ActionButton}" Margin="0" Command="{Binding Monitoring.RefreshCollectionEventsCommand}"/>
                                <StackPanel>
                                    <TextBlock Text="答卷收齐记录" Style="{StaticResource CardHeading}"/>
                                    <TextBlock Text="打开本页时每 20 秒自动刷新一次。" Style="{StaticResource CardNote}" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="{Binding Monitoring.CollectionStatus}" Style="{StaticResource CaptionText}" Margin="0,0,0,8"/>
                            <DataGrid ItemsSource="{Binding Monitoring.CollectionEvents}" Height="145">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="记录编号" Binding="{Binding EventId}" Width="*"/>
                                    <DataGridTextColumn Header="考试" Binding="{Binding ExamId}" Width="*"/>
                                    <DataGridTextColumn Header="名单批次" Binding="{Binding RosterVersion}" Width="100"/>
                                    <DataGridTextColumn Header="参试人数" Binding="{Binding ParticipantCount}" Width="100"/>
                                    <DataGridTextColumn Header="收齐时间" Binding="{Binding CompletedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="多设备冲突处理" Style="{StaticResource CardHeading}" />
                                <TextBlock Text="同一考生从两台设备进入时，指定保留哪一台继续答题。先在上表选中该考生。" Style="{StaticResource CardNote}" />
                                <TextBlock Text="参试记录（选中上表一行后自动填写）" Style="{StaticResource FormLabel}"/>
                                <TextBox Style="{StaticResource FormTextBox}" Margin="0,0,0,12" Text="{Binding Monitoring.ParticipationId}" IsReadOnly="True"/>
                                <TextBlock Text="保留的设备" Style="{StaticResource FormLabel}"/>
                                <TextBox Style="{StaticResource FormTextBox}" Margin="0,0,0,12" Text="{Binding Monitoring.SelectedDeviceId}" ToolTip="填写要保留继续答题的设备标识"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="记录版本（自动填写）" Style="{StaticResource FormLabel}"/>
                                        <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Monitoring.ExpectedVersionText}" IsReadOnly="True"
                                                 ToolTip="用于防止同时有人处理同一考生；选中上表一行后自动填写。"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="原因" Style="{StaticResource FormLabel}"/>
                                        <TextBox Style="{StaticResource FormTextBox}" Margin="0,0,0,12" Text="{Binding Monitoring.DecisionReason}" ToolTip="原因"/>
                                    </StackPanel>
                                </Grid>
                                <Button Content="确认保留该设备" Style="{StaticResource Btn.Danger}" HorizontalAlignment="Left" MinWidth="120" Padding="14,0" Command="{Binding Monitoring.DecideDeviceCommand}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="重发考试指令" Style="{StaticResource CardHeading}" />
                                <TextBlock Text="考生没有收到开始或结束指令时重发。先在上表选中该考生。" Style="{StaticResource CardNote}" />
                                <TextBlock Text="指令编号" Style="{StaticResource FormLabel}"/>
                                <TextBox Style="{StaticResource FormTextBox}" Margin="0,0,0,12" Text="{Binding Monitoring.EventId}" ToolTip="要重发的开始或结束指令编号"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="参试记录（自动填写）" Style="{StaticResource FormLabel}"/>
                                        <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Monitoring.ResendParticipationId}" IsReadOnly="True"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="答题设备（自动填写）" Style="{StaticResource FormLabel}"/>
                                        <TextBox Style="{StaticResource FormTextBox}" Margin="0,0,0,12" Text="{Binding Monitoring.ResendDeviceId}" IsReadOnly="True"/>
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="进入版本（自动填写）" Style="{StaticResource FormLabel}"/>
                                        <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Monitoring.EntryVersionText}" IsReadOnly="True"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="授权版本（自动填写）" Style="{StaticResource FormLabel}"/>
                                        <TextBox Style="{StaticResource FormTextBox}" Margin="0,0,0,12" Text="{Binding Monitoring.AuthorizationVersionText}" IsReadOnly="True"/>
                                    </StackPanel>
                                </Grid>
                                <Button Content="重发指令" Style="{StaticResource Btn.Primary}" HorizontalAlignment="Left" MinWidth="96" Command="{Binding Monitoring.ResendCommand}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>


        <TabItem Header="成绩统计" Tag="{StaticResource Icon.Chart}" IsEnabled="{Binding HasCurrentExam}" IsSelected="{Binding Reports.IsPageActive, Mode=TwoWay}">
            <reporting:ReportPageView DataContext="{Binding Reports}" />
        </TabItem>

        <TabItem Header="激活与试场分组" Tag="{StaticResource Icon.Device}">
            <ScrollViewer Style="{StaticResource PageScroller}">
                <StackPanel Style="{StaticResource PageBody}">
                    <HeaderedContentControl Style="{StaticResource PageHeading}" Header="激活与试场分组" Tag="{StaticResource Icon.Device}"
                        Content="审批设备激活，查看当前考生与连接情况；试场和转组记录保存在服务器。"/>
                    <Border Style="{StaticResource CardGap}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="刷新申请" Style="{StaticResource ActionButton}" Command="{Binding Activation.RefreshPendingCommand}"/>
                                <TextBlock Text="待审批申请" Style="{StaticResource CardHeading}"/>
                            </DockPanel>
                            <TextBlock Text="选中申请后选择试场再批准；不指定试场时保存为“未分组”。请与学生端显示的申请识别码核对。" Style="{StaticResource CardNote}"/>
                            <DataGrid ItemsSource="{Binding Activation.PendingRequests}" SelectedItem="{Binding Activation.SelectedPendingRequest}" Height="160" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="申请识别码" Binding="{Binding VerificationCode}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding ActivationRequestId}"/></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="申请时间" Binding="{Binding RequestedAtText}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel Margin="0,12,0,0">
                                <TextBlock Text="{Binding Activation.PendingSelectionText}" VerticalAlignment="Center" Margin="0,0,20,10"/>
                                <ComboBox ItemsSource="{Binding Activation.GroupChoices}" SelectedValue="{Binding Activation.ApprovalRoomGroupId, Mode=TwoWay}"
                                    DisplayMemberPath="Name" SelectedValuePath="RoomGroupId" Width="190" Margin="0,0,12,10"/>
                                <Button Content="审批" Style="{StaticResource PrimaryAction}" Command="{Binding Activation.ApproveCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardGap}">
                        <StackPanel>
                            <TextBlock Text="设备目录" Style="{StaticResource CardHeading}"/>
                            <TextBlock Text="按学生端编号、姓名、班级或准考证号查询；在线状态与当前业务页面分别显示。页面打开时自动刷新，也可手动重新读取。" Style="{StaticResource CardNote}"/>
                            <WrapPanel>
                                <StackPanel Width="270" Margin="0,0,12,0">
                                    <TextBlock Text="学生端编号或考生信息" Style="{StaticResource FormLabel}"/>
                                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding Activation.QueryDeviceId, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Width="190" Margin="0,0,12,0">
                                    <TextBlock Text="试场" Style="{StaticResource FormLabel}"/>
                                    <ComboBox ItemsSource="{Binding Activation.FilterChoices}" SelectedValue="{Binding Activation.FilterRoomGroupId, Mode=TwoWay}"
                                        DisplayMemberPath="Name" SelectedValuePath="RoomGroupId"/>
                                </StackPanel>
                                <Button Content="查询设备" Style="{StaticResource ActionButton}" VerticalAlignment="Bottom" Command="{Binding Activation.QueryDeviceCommand}"/>
                                <Button Content="重新读取目录" Style="{StaticResource ActionButton}" VerticalAlignment="Bottom" Command="{Binding Activation.RefreshDirectoryCommand}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding Activation.DirectoryStatus}" Style="{StaticResource CaptionText}" Margin="0,0,0,10"/>
                            <DataGrid ItemsSource="{Binding Activation.Devices}" SelectedItem="{Binding Activation.SelectedDevice}" IsReadOnly="False"
                                Height="270" HorizontalScrollBarVisibility="Auto" CanUserAddRows="False" CanUserDeleteRows="False">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="转组" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                                    <DataGridTextColumn Header="学生端编号" Binding="{Binding ClientNumber}" Width="125" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="试场" Binding="{Binding RoomGroupName}" Width="130" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="激活状态" Binding="{Binding ActivationStatus}" Width="90" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="连接状态" Binding="{Binding ConnectionStatus}" Width="90" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="当前考生" Binding="{Binding Candidate}" Width="110" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="班级" Binding="{Binding ClassText}" Width="75" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="准考证号" Binding="{Binding AdmissionNo}" Width="110" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="考试" Binding="{Binding ExamName}" Width="160" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="当前页面" Binding="{Binding Page}" Width="110" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="最后有效通信" Binding="{Binding LastSeen}" Width="140" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="勾选本页全部" Style="{StaticResource ActionButton}" Command="{Binding Activation.SelectAllDevicesCommand}"/>
                                <Button Content="取消勾选" Style="{StaticResource ActionButton}" Command="{Binding Activation.ClearDeviceSelectionCommand}"/>
                                <ComboBox ItemsSource="{Binding Activation.GroupChoices}" SelectedValue="{Binding Activation.MoveToRoomGroupId, Mode=TwoWay}"
                                    DisplayMemberPath="Name" SelectedValuePath="RoomGroupId" Width="190" Margin="0,0,12,10"/>
                                <TextBox Width="260" Margin="0,0,12,10" ToolTip="转组原因" Text="{Binding Activation.MoveReason, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Content="整批转入所选试场" Style="{StaticResource PrimaryAction}" Command="{Binding Activation.MoveDevicesCommand}"/>
                            </WrapPanel>
                            <TextBlock Text="勾选多台设备可整批转组；未勾选时处理当前选中设备。请填写转组原因，任一设备版本变化都不会部分转组。" Style="{StaticResource CaptionText}"/>
                            <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,14"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="查看选中设备的转组历史" Style="{StaticResource ActionButton}" Command="{Binding Activation.DeviceHistoryCommand}"/>
                                <TextBlock Text="转组历史" Style="{StaticResource CardHeading}"/>
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding Activation.DeviceHistory}" Height="160" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="时间" Binding="{Binding ChangedAt}" Width="170"/>
                                    <DataGridTextColumn Header="原试场" Binding="{Binding FromGroupName}" Width="*"/>
                                    <DataGridTextColumn Header="新试场" Binding="{Binding ToGroupName}" Width="*"/>
                                    <DataGridTextColumn Header="操作账号" Binding="{Binding Operator}" Width="130"/>
                                    <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardGap}">
                        <StackPanel>
                            <TextBlock Text="试场分组" Style="{StaticResource CardHeading}"/>
                            <TextBlock Text="分组属于当前服务器，与具体考试无关；删除时由服务器检查所有设备，非空试场不能删除。" Style="{StaticResource CardNote}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="新试场名称" Style="{StaticResource FormLabel}"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="新增" Style="{StaticResource ActionButton}" Command="{Binding Activation.AddGroupCommand}"/>
                                        <TextBox Text="{Binding Activation.NewGroupName, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="选中试场的新名称" Style="{StaticResource FormLabel}"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="重命名" Style="{StaticResource ActionButton}" Command="{Binding Activation.RenameGroupCommand}"/>
                                        <TextBox Text="{Binding Activation.SelectedGroupName, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Grid>
                            <DataGrid ItemsSource="{Binding Activation.Groups}" SelectedItem="{Binding Activation.SelectedGroup}" Height="170" Margin="0,10,0,8" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="试场名称" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="设备数" Binding="{Binding DeviceCount}" Width="140"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Content="删除选中的空试场" Style="{StaticResource Btn.Danger}" HorizontalAlignment="Left" Command="{Binding Activation.RemoveGroupCommand}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding Activation.Status}" Style="{StaticResource StatusLine}"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- 考务账号：仅管理员可见。批准新注册的账号，停用或重新启用账号。 -->
        <TabItem Header="考务账号管理" Tag="{StaticResource Icon.Lock}"
                 Visibility="{Binding Connection.IsAdministrator, Converter={StaticResource BoolToVis}}">
            <ScrollViewer Style="{StaticResource PageScroller}">
                <StackPanel Style="{StaticResource PageBody}">
                    <DockPanel Margin="0,0,0,20">
                        <Button DockPanel.Dock="Right" Content="刷新" Style="{StaticResource ActionButton}" Margin="0" VerticalAlignment="Center"
                                Command="{Binding Accounts.RefreshCommand}"/>
                        <HeaderedContentControl Style="{StaticResource PageHeading}" Header="考务账号管理" Tag="{StaticResource Icon.Lock}" Margin="0"
                                                Content="新注册的考务账号经管理员批准后才能登录；账号停用后立即退出登录。" />
                    </DockPanel>
                    <TextBlock Text="{Binding Accounts.Status}" Style="{StaticResource CaptionText}" Margin="0,0,0,12"/>
                    <Border Style="{StaticResource CardGap}">
                        <DataGrid ItemsSource="{Binding Accounts.Accounts}" IsReadOnly="True" MinHeight="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="姓名" Binding="{Binding DisplayName}" Width="*"/>
                                <DataGridTextColumn Header="用户名" Binding="{Binding Username}" Width="*"/>
                                <DataGridTextColumn Header="角色" Binding="{Binding RoleText}" Width="110"/>
                                <DataGridTemplateColumn Header="状态" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <controls:StatusPill Text="{Binding StatusText}" Level="{Binding StatusLevel}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="注册时间" Binding="{Binding CreatedText}" Width="150"/>
                                <DataGridTemplateColumn Header="操作" Width="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="{Binding ApproveText}" Style="{StaticResource Btn.Primary}" MinWidth="72" Padding="10,0" Margin="0,0,8,0"
                                                        Command="{Binding ApproveCommand}"/>
                                                <Button Content="停用" Style="{StaticResource Btn.Secondary}" MinWidth="72" Padding="10,0"
                                                        Command="{Binding DisableCommand}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="试卷导入与发布" Tag="{StaticResource Icon.Layers}" IsEnabled="{Binding HasCurrentExam}">
            <ScrollViewer Style="{StaticResource PageScroller}">
                <StackPanel Style="{StaticResource PageBody}">
                    <HeaderedContentControl Style="{StaticResource PageHeading}" Header="试卷导入与发布"
                        Content="选择当前考试的本地逐题目录或 ZIP；检查、逐题预览和明确确认后，才会正式发布。"/>
                    <Border Style="{StaticResource CardGap}">
                        <StackPanel>
                            <TextBlock Text="当前考试" Style="{StaticResource FormLabel}"/>
                            <TextBlock Text="{Binding Import.ExamName}" Style="{StaticResource CardHeading}"/>
                            <TextBlock Text="试题包来源" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding Import.SourcePath, Mode=OneWay}" Style="{StaticResource FormTextBox}" IsReadOnly="True"/>
                            <TextBlock Text="本次修改原因（开考后修订必填，随版本一起记录）" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding Import.PublishReason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}" IsEnabled="{Binding Import.CanEditRevisionDetails}" />
                            <TextBlock Text="变更题号（空格、逗号或顿号分隔；留空＝按内容自动算出。开考后修订会以这里声明的为准，服务器按内容核对，不一致会拒绝发布）"
                                       Style="{StaticResource CardNote}" TextWrapping="Wrap"/>
                            <TextBox Text="{Binding Import.ChangedQuestionsText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}" IsEnabled="{Binding Import.CanEditRevisionDetails}" />
                            <WrapPanel>
                                <Button Content="选择目录" Style="{StaticResource ActionButton}" Command="{Binding Import.SelectDirectoryCommand}"/>
                                <Button Content="选择 ZIP" Style="{StaticResource ActionButton}" Command="{Binding Import.SelectZipCommand}"/>
                                <Button Content="检查并生成预览" Style="{StaticResource PrimaryAction}" Command="{Binding Import.CheckCommand}"/>
                                <Button Content="取回当前版本源材料" Style="{StaticResource ActionButton}" Command="{Binding Import.RetrieveMaterialsCommand}"/>
                                <Button Content="取消当前操作" Style="{StaticResource ActionButton}" Command="{Binding Import.CancelCommand}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding Import.ChangedQuestionsHint}" Style="{StaticResource CardNote}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Import.Status}" Style="{StaticResource StatusLine}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardGap}">
                        <StackPanel>
                            <TextBlock Text="本次只读预览：逐题检查 PDF 版式与选项" Style="{StaticResource CardHeading}"/>
                            <DataGrid ItemsSource="{Binding Import.Questions}" SelectedItem="{Binding Import.SelectedQuestion}" IsReadOnly="True"
                                      AutoGenerateColumns="False" Height="270" Margin="0,10,0,10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="题号" Binding="{Binding QuestionNo}" Width="60"/>
                                    <DataGridTextColumn Header="科目" Binding="{Binding Subject}" Width="*"/>
                                    <DataGridTextColumn Header="题组" Binding="{Binding Group}" Width="*"/>
                                    <DataGridTextColumn Header="题型" Binding="{Binding Type}" Width="95"/>
                                    <DataGridTextColumn Header="逐题满分" Binding="{Binding Score}" Width="80"/>
                                    <DataGridTextColumn Header="选项" Binding="{Binding Options}" Width="140"/>
                                    <DataGridTextColumn Header="参考答案" Binding="{Binding CorrectOptions}" Width="90"/>
                                    <DataGridTextColumn Header="PDF 页数" Binding="{Binding PageCount}" Width="80"/>
                                    <DataGridTextColumn Header="选项绑定页" Binding="{Binding RegionPages}" Width="180"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel>
                                <Button Content="打开选中题目 PDF" Style="{StaticResource ActionButton}" Command="{Binding Import.OpenQuestionCommand}"/>
                                <Button Content="确认并正式发布" Style="{StaticResource PrimaryAction}" Command="{Binding Import.PublishCommand}"/>
                            </WrapPanel>
                            <TextBlock Text="发布成功仅表示服务器整套试卷与答案规则已生效，不代表所有学生端均已更新。"
                                       Style="{StaticResource CardNote}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardGap}">
                        <StackPanel>
                            <TextBlock Text="只改答案与计分规则" Style="{StaticResource CardHeading}"/>
                            <TextBlock Text="不重新编译、不组包：从所选材料包读取清单与完整答案提交发布，服务器随后按新版本安排重算。重算期间旧报表不可查询或导出。"
                                       Style="{StaticResource CardNote}" TextWrapping="Wrap"/>
                            <TextBlock Text="材料包目录（含 manifest.json 与 server-only/answer-key.json）" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding GradingRevision.PackagePath, Mode=OneWay}" Style="{StaticResource FormTextBox}" IsReadOnly="True"/>
                            <TextBlock Text="本次修改原因（随规则版本一起记录）" Style="{StaticResource FormLabel}"/>
                            <TextBox Text="{Binding GradingRevision.Reason, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding GradingRevision.CanEditRevision}" Style="{StaticResource FormTextBox}"/>
                            <WrapPanel>
                                <Button Content="选择材料包目录" Style="{StaticResource ActionButton}" Command="{Binding GradingRevision.SelectPackageCommand}"/>
                                <Button Content="检查并预览规则" Style="{StaticResource ActionButton}" Command="{Binding GradingRevision.CheckCommand}"/>
                                <Button Content="确认发布 / 重试原请求" Style="{StaticResource PrimaryAction}" Command="{Binding GradingRevision.PublishCommand}"/>
                                <Button Content="刷新重算状态" Style="{StaticResource ActionButton}" Command="{Binding GradingRevision.RefreshStatusCommand}"/>
                            </WrapPanel>
                            <DataGrid ItemsSource="{Binding GradingRevision.Questions}" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" MinHeight="100" MaxHeight="300" Margin="0,8,0,8">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="题号" Binding="{Binding QuestionNo}" Width="80"/>
                                    <DataGridTextColumn Header="参考答案" Binding="{Binding CorrectOptions}" Width="*"/>
                                    <DataGridTextColumn Header="满分" Binding="{Binding FullScore}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="{Binding GradingRevision.Status}" Style="{StaticResource StatusLine}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding GradingRevision.PublishedText}" Style="{StaticResource CardNote}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding GradingRevision.RecalculationText}" Style="{StaticResource CardNote}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        </TabControl>
        </Grid>
    </Grid>
</Window>
