<Window x:Class="Exam.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:reporting="clr-namespace:Exam.Admin.Reporting"
        xmlns:ui="clr-namespace:Exam.Admin.Infrastructure"
        xmlns:controls="clr-namespace:Exam.Desktop.Shared.Controls;assembly=Exam.Desktop.Shared"
        Title="怀籀传承在线考试系统 · 考务端" Width="1440" Height="900"
        MinWidth="1120" MinHeight="720"
        Background="{DynamicResource Brush.Background}"
        FontFamily="{DynamicResource Font.Family}"
        UseLayoutRounding="True"
        Closed="MainWindow_OnClosed">
    <Window.Resources>
        <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}" />
        <Style x:Key="ExamSettingsGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="CanUserSortColumns" Value="False" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="RowBackground" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="RowStyle">
                <Setter.Value><Style TargetType="DataGridRow" /></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ImportPreviewCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style x:Key="FormTextBox" TargetType="TextBox" BasedOn="{StaticResource Tbx.Base}">
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource Btn.Secondary}">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="14,0" />
        </Style>
        <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="14,0" />
        </Style>
        <Style x:Key="ScoreTokenButton" TargetType="Button" BasedOn="{StaticResource Btn.Secondary}">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
        <Style x:Key="ScoreTokenBar" TargetType="WrapPanel">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag.Tag, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PageScroller" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style x:Key="PageBody" TargetType="StackPanel">
            <Setter Property="Margin" Value="{StaticResource Padding.Page}" />
        </Style>
        <Style x:Key="CardGap" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="CardHeading" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="CardNote" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="StatusLine" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <!-- 页头：图标块 + 页面标题（Header）+ 用途说明（Content）；图标几何放在 Tag -->
        <Style x:Key="PageHeading" TargetType="HeaderedContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,0,0,20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="HeaderedContentControl">
                        <DockPanel>
                            <Border Style="{StaticResource IconTile}" Width="44" Height="44" CornerRadius="11">
                                <Path Style="{StaticResource IconTile.Glyph}" Width="22" Height="22"
                                      Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource PageTitle}"
                                           Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" />
                                <TextBlock Style="{StaticResource PageSubtitle}"
                                           Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                            </StackPanel>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <controls:Banner Grid.Row="0" Level="Warning" Margin="12,8,12,4" Padding="12"
                         DataContext="{Binding Management, RelativeSource={RelativeSource AncestorType=Window}}"
                         IsOpen="{Binding ShowProtectionWarning}" Message="{Binding ProtectionText}"/>
        <Grid Grid.Row="1">
        <!-- 登录页（未登录时显示，覆盖整个窗口区域） -->
        <ContentControl x:Name="PageRegion" />

        <!-- 主界面（登录后显示） -->
        <TabControl x:Name="MainTabArea"
                    Style="{StaticResource Nav.TabControl}" Tag="考务端"
                    SelectedIndex="{Binding SelectedPage, Mode=TwoWay}"
                    SelectionChanged="OnSelectedPageChanged">
        <controls:NavShell.TopBar>
            <!-- 已登录状态栏：账号信息 + 退出登录 + 服务器状态 + 当前考试条。 -->
            <Border Style="{StaticResource TopBar}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="退出登录" Style="{StaticResource Btn.Secondary}" MinWidth="96" Padding="14,0"
                                Command="{Binding Connection.LogoutCommand}" />
                        <Button DockPanel.Dock="Right" Content="本机服务管理" Style="{StaticResource Btn.Secondary}"
                                Margin="0,0,8,0" Click="OnManagementRequested" />
                        <Border Style="{StaticResource IconTile}" Width="36" Height="36" CornerRadius="9" Margin="0,0,12,0">
                            <Path Style="{StaticResource IconTile.Glyph}" Data="{StaticResource Icon.Users}" Width="18" Height="18" />
                        </Border>
                        <TextBlock Text="{Binding Connection.AccountTitle}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <Path Data="{StaticResource Icon.Server}" Style="{StaticResource IconTile.Glyph}" Width="13" Height="13"
                              Stroke="{DynamicResource Brush.Text.Secondary}" StrokeThickness="1.5" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Connection.Status}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- 当前考试：进入某场考试或新建考试时显示，不在主页显示。 -->
                    <Border Grid.Row="2" Margin="-28,12,-28,-12" Padding="28,10"
                            Background="{DynamicResource Brush.Primary.Soft}"
                            Visibility="{Binding ShowCurrentExamBar, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="返回全部考试" Style="{StaticResource Btn.Secondary}" Padding="14,0"
                                    Command="{Binding BackToHomeCommand}"/>
                            <TextBlock Text="当前考试" Style="{StaticResource FieldLabel}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentExamTitle}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </controls:NavShell.TopBar>

        <!-- 主页：全部考试以卡片列出，按名称区分；点击卡片进入该场考试，或新建考试。 -->
        <TabItem Header="全部考试" Tag="{StaticResource Icon.Layers}">
            <ScrollViewer Style="{StaticResource PageScroller}">
                <StackPanel Style="{StaticResource PageBody}">
                    <DockPanel Margin="0,0,0,20">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="刷新" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Command="{Binding Home.RefreshCommand}"/>
                            <Button Content="新建考试" Style="{StaticResource PrimaryAction}" Margin="0" Command="{Binding Home.NewExamCommand}"/>
                        </StackPanel>
                        <HeaderedContentControl Style="{StaticResource PageHeading}" Header="全部考试" Tag="{StaticResource Icon.Layers}" Margin="0"
                                                Content="点击考试进入设置、监控和成绩统计，或新建考试。" />
                    </DockPanel>
                    <TextBlock Text="{Binding Home.Status}" Style="{StaticResource CaptionText}" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding Home.Exams}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding OpenCommand}" Height="Auto" Margin="0,0,0,12" Padding="0" Cursor="Hand"
                                        HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Name}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Card" Style="{StaticResource Card}" Padding="20,18">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Focus.Ring}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <!-- 一行一场考试；名称自动换行，完整显示。 -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}" Width="44" Height="44" CornerRadius="11" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <Path Style="{StaticResource IconTile.Glyph}" Data="{StaticResource Icon.Document}" Width="22" Height="22" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding TimeText}" Style="{StaticResource BodyText}" Margin="0,6,0,0"/>
                                            <TextBlock Text="{Binding ParticipantsText}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <controls:StatusPill Text="{Binding StateText}" Level="{Binding StateLevel}" Margin="0,0,8,0"/>
                                                <controls:StatusPill Text="{Binding VisibilityText}" Level="{Binding VisibilityLevel}"/>
                                            </StackPanel>
                                            <controls:StatusPill Text="{Binding PublicationText}" Level="{Binding PublicationLevel}" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="考试设置" Tag="{StaticResource Icon.Calendar}" IsEnabled="{Binding CanEditSettings}">
            <ScrollViewer Style="{StaticResource PageScroller}">
                <StackPanel Style="{StaticResource PageBody}">
                    <HeaderedContentControl Style="{StaticResource PageHeading}" Header="{Binding Exam.Heading}" Tag="{StaticResource Icon.Calendar}"
                                    Content="填写考试名称、起止时间、科目与题组计分规则，保存到服务器后由此生成学生端的考试说明。" />
                    <Border Style="{StaticResource CardGap}">
                        <StackPanel>
                            <TextBlock Text="考试基础信息" Style="{StaticResource CardHeading}" />
                            <TextBlock Text="考试名称会用作试题文件名的开头，不能包含 \ / : * ? &quot; &lt; &gt; | 等字符；时间按“年-月-日 时:分”填写。" Style="{StaticResource CardNote}" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="考试名称" Style="{StaticResource FormLabel}"/>
                                    <TextBox Style="{StaticResource FormTextBox}" IsEnabled="{Binding Exam.IsSettingsEditable}"
                                             Text="{Binding Exam.Name, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="开始时间" Style="{StaticResource FormLabel}"/>
                                    <TextBox Style="{StaticResource FormTextBox}" IsEnabled="{Binding Exam.CanEditTime}" Text="{Binding Exam.ScheduledStartText, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="结束时间" Style="{StaticResource FormLabel}"/>
                                    <TextBox Style="{StaticResource FormTextBox}" Margin="0,0,0,12" IsEnabled="{Binding Exam.CanEditTime}" Text="{Binding Exam.ScheduledEndText, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="修改时间的原因" Style="{StaticResource FormLabel}"/>
                            <TextBox Style="{StaticResource FormTextBox}" MaxLength="1000"
                                     IsEnabled="{Binding Exam.CanEditTime}"
                                     Text="{Binding Exam.ScheduleChangeReason, UpdateSourceTrigger=PropertyChanged}"/>
                            <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,4,0,14" />
                            <WrapPanel>
                                <StackPanel Margin="0,0,48,8">
                                    <Button Content="校验并生成说明" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Command="{Binding Exam.RefreshInstructionsCommand}"/>
                                    <TextBlock Text="检查并预览考试说明，不会保存到服务器。" Style="{StaticResource CaptionText}" TextWrapping="NoWrap"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,48,8">
                                    <Button Content="保存考试设置" Style="{StaticResource PrimaryAction}" HorizontalAlignment="Left" Command="{Binding Exam.SaveCommand}"/>
                                    <TextBlock Text="把本页填写的考试设置保存到服务器。" Style="{StaticResource CaptionText}" TextWrapping="NoWrap"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <Button Content="重新从服务器读取当前考试" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Command="{Binding Exam.ReloadCommand}"/>
                                    <TextBlock Text="读取已保存设置，覆盖本页未保存的修改。" Style="{StaticResource CaptionText}" TextWrapping="NoWrap"/>
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Text="{Binding Exam.Status}" Style="{StaticResource StatusLine}"/>
                        </StackPanel>
                    </Border>
                    <!-- 学生端显示：随时可改；有考生确认参试后，全部答卷回收前不能取消显示。 -->
                    <Border Style="{StaticResource CardGap}">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Content="在学生端显示本场考试" VerticalAlignment="Center"
                                      IsChecked="{Binding Exam.VisibleToStudents, Mode=TwoWay}" IsEnabled="{Binding Exam.CanChangeVisibility}"/>
                            <StackPanel>
                                <TextBlock Text="学生端显示" Style="{StaticResource CardHeading}" />
                                <TextBlock Text="{Binding Exam.VisibilityNote}" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource CardGap}">
                        <StackPanel>
                            <TextBlock Text="科目与题组" Style="{StaticResource CardHeading}" />
                            <TextBlock Text="先在上表选中一个科目，再在下表编辑它的题组和计分规则。" Style="{StaticResource CardNote}" />
                            <DataGrid Style="{StaticResource ExamSettingsGrid}" ItemsSource="{Binding Exam.Subjects}" SelectedItem="{Binding Exam.SelectedSubject}" IsEnabled="{Binding Exam.IsSettingsEditable}" IsReadOnly="False" MinHeight="150" MaxHeight="260" Margin="0,0,0,6">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Visibility="Collapsed" IsReadOnly="True" Header="科目编号" Binding="{Binding SubjectId, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridTextColumn Header="科目名称" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridTextColumn Header="满分" Binding="{Binding MaxScore, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel Margin="0,0,0,14">
                                <Button Content="新增科目" Style="{StaticResource ActionButton}" Command="{Binding Exam.AddSubjectCommand}"/>
                                <Button Content="删除科目" Style="{StaticResource ActionButton}" Command="{Binding Exam.RemoveSubjectCommand}"/>
                            </WrapPanel>
                            <DataGrid Style="{StaticResource ExamSettingsGrid}" ItemsSource="{Binding Exam.SelectedSubject.Groups}" SelectedItem="{Binding Exam.SelectedSubject.SelectedGroup}"
                                      IsEnabled="{Binding Exam.IsSettingsEditable}" IsReadOnly="False" Height="180">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="题组名" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridTextColumn IsReadOnly="True" Header="题型" Binding="{Binding TypeLabel}" Width="150"/>
                                    <DataGridTextColumn IsReadOnly="True" Header="顺序" Binding="{Binding Order}" Width="80"/>
                                    <DataGridTextColumn IsReadOnly="True" Header="题量" Binding="{Binding QuestionCount}" Width="80"/>
                                    <DataGridTextColumn IsReadOnly="True" Header="满分" Binding="{Binding MaxScore}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="题组名可直接在表格中编辑；选中题组后，在下方设置题型、顺序、题量、满分和计分规则。" Style="{StaticResource CardNote}" Margin="0,10,0,10"/>
                            <StackPanel IsEnabled="{Binding Exam.IsSettingsEditable}">
                                <StackPanel DataContext="{Binding Exam.SelectedSubject.SelectedGroup}">
                                    <WrapPanel>
                                        <StackPanel Width="210" Margin="0,0,16,0">
                                            <TextBlock Text="题型" Style="{StaticResource FormLabel}"/>
                                            <ComboBox SelectedValue="{Binding Type, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                                ItemsSource="{Binding DataContext.Exam.QuestionTypes, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </StackPanel>
                                        <StackPanel Width="100" Margin="0,0,16,0">
                                            <TextBlock Text="顺序" Style="{StaticResource FormLabel}"/>
                                            <TextBox Text="{Binding OrderText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                                        </StackPanel>
                                        <StackPanel Width="100" Margin="0,0,16,0">
                                            <TextBlock Text="题量" Style="{StaticResource FormLabel}"/>
                                            <TextBox Text="{Binding QuestionCountText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                                        </StackPanel>
                                        <StackPanel Width="100" Margin="0,0,16,0">
                                            <TextBlock Text="满分" Style="{StaticResource FormLabel}"/>
                                            <TextBox Text="{Binding MaxScore, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                                        </StackPanel>
                                    </WrapPanel>
                                    <CheckBox Content="允许考生选择“不作答”" IsChecked="{Binding AllowAbstain}" Margin="0,8,0,14"/>
                                    <TextBlock Style="{StaticResource CardNote}" TextWrapping="Wrap"
                                               Text="{}计分规则支持整数、有限小数（如 0.5、-0.75）、{正确选项总数}、{选择的正确选项数}，以及 +、-、*、/ 和括号。先点击要编辑的计分框，再用下方按钮在光标处插入；括号按钮也可包住所选内容。"/>
                                    <TextBlock Style="{StaticResource CardNote}" TextWrapping="Wrap"
                                               Text="{}例如，选对但不全可填 {选择的正确选项数} * 0.5，表示每选对一个选项得 0.5 分。规则不能除以零，最终每题得分必须是有限小数。"/>
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="multiple"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="计分规则（一个正确答案的试题）" Style="{StaticResource FormLabel}"/>
                                        <WrapPanel x:Name="OneCorrectScoreFields" GotKeyboardFocus="OnScoreFieldFocused" DataContextChanged="OnScoreFieldsDataContextChanged">
                                            <StackPanel Width="160" Margin="0,0,16,0">
                                                <TextBlock Text="选对" Style="{StaticResource FormLabel}"/>
                                                <TextBox Text="{Binding Correct, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                                            </StackPanel>
                                            <StackPanel Width="160" Margin="0,0,16,0">
                                                <TextBlock Text="不选" Style="{StaticResource FormLabel}"/>
                                                <TextBox Text="{Binding OneBlank, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                                            </StackPanel>
                                            <StackPanel Width="160" Margin="0,0,16,0">
                                                <TextBlock Text="选错" Style="{StaticResource FormLabel}"/>
                                                <TextBox Text="{Binding OneWrong, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                                            </StackPanel>
                                        </WrapPanel>
                                        <WrapPanel Style="{StaticResource ScoreTokenBar}" Tag="{Binding ElementName=OneCorrectScoreFields}" ButtonBase.Click="OnScoreTokenClicked">
                                            <Button Content="{}{正确选项总数}" Tag="{}{正确选项总数}" Style="{StaticResource ScoreTokenButton}"/>
                                            <Button Content="{}{选择的正确选项数}" Tag="{}{选择的正确选项数}" Style="{StaticResource ScoreTokenButton}"/>
                                            <Button Content="+" Tag="+" Style="{StaticResource ScoreTokenButton}"/>
                                            <Button Content="-" Tag="-" Style="{StaticResource ScoreTokenButton}"/>
                                            <Button Content="*" Tag="*" Style="{StaticResource ScoreTokenButton}"/>
                                            <Button Content="/" Tag="/" Style="{StaticResource ScoreTokenButton}"/>
                                            <Button Content="（ ）" Tag="()" ToolTip="插入成对括号，或包住所选内容" Style="{StaticResource ScoreTokenButton}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="single"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="计分规则（多个正确答案的试题）" Style="{StaticResource FormLabel}"/>
                                        <WrapPanel x:Name="MultipleCorrectScoreFields" GotKeyboardFocus="OnScoreFieldFocused" DataContextChanged="OnScoreFieldsDataContextChanged">
                                            <StackPanel Width="160" Margin="0,0,16,0">
                                                <TextBlock Text="全部选对" Style="{StaticResource FormLabel}"/>
                                                <TextBox Text="{Binding AllCorrect, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                                            </StackPanel>
                                            <StackPanel Width="160" Margin="0,0,16,0">
                                                <TextBlock Text="选对但不全" Style="{StaticResource FormLabel}"/>
                                                <TextBox Text="{Binding PartialCorrect, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                                            </StackPanel>
                                            <StackPanel Width="160" Margin="0,0,16,0">
                                                <TextBlock Text="不选" Style="{StaticResource FormLabel}"/>
                                                <TextBox Text="{Binding MultipleBlank, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                                            </StackPanel>
                                            <StackPanel Width="160" Margin="0,0,16,0">
                                                <TextBlock Text="选错" Style="{StaticResource FormLabel}"/>
                                                <TextBox Text="{Binding MultipleWrong, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                                            </StackPanel>
                                        </WrapPanel>
                                        <WrapPanel Style="{StaticResource ScoreTokenBar}" Tag="{Binding ElementName=MultipleCorrectScoreFields}" ButtonBase.Click="OnScoreTokenClicked">
                                            <Button Content="{}{正确选项总数}" Tag="{}{正确选项总数}" Style="{StaticResource ScoreTokenButton}"/>
                                            <Button Content="{}{选择的正确选项数}" Tag="{}{选择的正确选项数}" Style="{StaticResource ScoreTokenButton}"/>
                                            <Button Content="+" Tag="+" Style="{StaticResource ScoreTokenButton}"/>
                                            <Button Content="-" Tag="-" Style="{StaticResource ScoreTokenButton}"/>
                                            <Button Content="*" Tag="*" Style="{StaticResource ScoreTokenButton}"/>
                                            <Button Content="/" Tag="/" Style="{StaticResource ScoreTokenButton}"/>
                                            <Button Content="（ ）" Tag="()" ToolTip="插入成对括号，或包住所选内容" Style="{StaticResource ScoreTokenButton}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="新增题组" Style="{StaticResource ActionButton}" Command="{Binding Exam.AddGroupCommand}"/>
