                                    <DataGridTextColumn Header="班级" Binding="{Binding ClassText}" Width="70"/>
                                    <DataGridTextColumn Header="准考证号" Binding="{Binding AdmissionNo}" Width="110"/>
                                    <DataGridTextColumn Header="学生端编号" Binding="{Binding ClientNumber}" Width="120"/>
                                    <DataGridTextColumn Header="试场" Binding="{Binding RoomGroup}" Width="90"/>
