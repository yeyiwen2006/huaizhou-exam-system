                                    <TextBlock Text="{Binding Monitoring.SelectedConflictDevice.DiagnosticText}" Style="{StaticResource CardNote}"/>
                                </Expander>
                                <TextBlock Text="选中要保留的设备后确认，原因会写入操作记录。" Style="{StaticResource CardNote}" Margin="0,8,0,0"/>
                                <TextBlock Text="原因" Style="{StaticResource FormLabel}"/>
                                <TextBox Style="{StaticResource FormTextBox}" Margin="0,0,0,12" Text="{Binding Monitoring.DecisionReason}" ToolTip="填写保留该设备的原因"/>
                                <Button Content="确认保留该设备" Style="{StaticResource Btn.Danger}" HorizontalAlignment="Left" MinWidth="120" Padding="14,0" Command="{Binding Monitoring.DecideDeviceCommand}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="重发考试指令" Style="{StaticResource CardHeading}" />
                                <TextBlock Text="考生没有收到开始或结束指令时重发。先在上表选中该考生，再按名称选择要重发的指令。" Style="{StaticResource CardNote}" />
                                <TextBlock Text="可重发的指令（按名称选择）" Style="{StaticResource FormLabel}"/>
                                <ComboBox ItemsSource="{Binding Monitoring.SelectedCommands}" SelectedItem="{Binding Monitoring.SelectedCommand}" DisplayMemberPath="DisplayText" Height="32" Margin="0,0,0,12"/>
                                <Button Content="重发指令" Style="{StaticResource Btn.Primary}" HorizontalAlignment="Left" MinWidth="96" Command="{Binding Monitoring.ResendCommand}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>


        <TabItem Header="成绩统计" Tag="{StaticResource Icon.Chart}" IsEnabled="{Binding HasCurrentExam}" IsSelected="{Binding Reports.IsPageActive, Mode=TwoWay}">
            <reporting:ReportPageView DataContext="{Binding Reports}" />
        </TabItem>

        <TabItem Header="激活与试场分组" Tag="{StaticResource Icon.Device}">
            <ScrollViewer Style="{StaticResource PageScroller}">
                <StackPanel Style="{StaticResource PageBody}">
                    <HeaderedContentControl Style="{StaticResource PageHeading}" Header="激活与试场分组" Tag="{StaticResource Icon.Device}"
                        Content="审批设备激活，查看当前考生与连接情况；试场和转组记录保存在服务器。"/>
                    <Border Style="{StaticResource CardGap}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="刷新申请" Style="{StaticResource ActionButton}" Command="{Binding Activation.RefreshPendingCommand}"/>
                                <TextBlock Text="待审批申请" Style="{StaticResource CardHeading}"/>
                            </DockPanel>
                            <TextBlock Text="选中申请后选择试场再批准；不指定试场时保存为“未分组”。请与学生端显示的申请识别码核对。" Style="{StaticResource CardNote}"/>
                            <DataGrid ItemsSource="{Binding Activation.PendingRequests}" SelectedItem="{Binding Activation.SelectedPendingRequest}" Height="160" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="申请识别码" Binding="{Binding VerificationCode}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding ActivationRequestId}"/></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="申请时间" Binding="{Binding RequestedAtText}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel Margin="0,12,0,0">
                                <TextBlock Text="{Binding Activation.PendingSelectionText}" VerticalAlignment="Center" Margin="0,0,20,10"/>
                                <ComboBox ItemsSource="{Binding Activation.GroupChoices}" SelectedValue="{Binding Activation.ApprovalRoomGroupId, Mode=TwoWay}"
                                    DisplayMemberPath="Name" SelectedValuePath="RoomGroupId" Width="190" Margin="0,0,12,10"/>
                                <Button Content="审批" Style="{StaticResource PrimaryAction}" Command="{Binding Activation.ApproveCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardGap}">
                        <StackPanel>
                            <TextBlock Text="设备目录" Style="{StaticResource CardHeading}"/>
                            <TextBlock Text="按学生端编号、姓名、班级或准考证号查询；在线状态与当前业务页面分别显示。页面打开时自动刷新，也可手动重新读取。" Style="{StaticResource CardNote}"/>
                            <WrapPanel>
                                <StackPanel Width="270" Margin="0,0,12,0">
                                    <TextBlock Text="学生端编号或考生信息" Style="{StaticResource FormLabel}"/>
                                    <TextBox Style="{StaticResource FormTextBox}" Margin="0,0,0,12" Text="{Binding Activation.QueryDeviceId, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Width="190" Margin="0,0,12,0">
                                    <TextBlock Text="试场" Style="{StaticResource FormLabel}"/>
                                    <ComboBox ItemsSource="{Binding Activation.FilterChoices}" SelectedValue="{Binding Activation.FilterRoomGroupId, Mode=TwoWay}"
                                        DisplayMemberPath="Name" SelectedValuePath="RoomGroupId" Height="{DynamicResource Control.Height}" Margin="0,0,0,12"/>
                                </StackPanel>
                                <Button Content="查询设备" Style="{StaticResource ActionButton}" Margin="0,0,8,12" VerticalAlignment="Bottom" Command="{Binding Activation.QueryDeviceCommand}"/>
                                <Button Content="重新读取目录" Style="{StaticResource ActionButton}" Margin="0,0,8,12" VerticalAlignment="Bottom" Command="{Binding Activation.RefreshDirectoryCommand}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding Activation.DirectoryStatus}" Style="{StaticResource CaptionText}" Margin="0,0,0,10"/>
                            <DataGrid ItemsSource="{Binding Activation.Devices}" SelectedItem="{Binding Activation.SelectedDevice}" IsReadOnly="False"
                                Height="270" HorizontalScrollBarVisibility="Auto" CanUserAddRows="False" CanUserDeleteRows="False">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="转组" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                                    <DataGridTextColumn Header="学生端编号" Binding="{Binding ClientNumber}" Width="125" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="试场" Binding="{Binding RoomGroupName}" Width="130" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="激活状态" Binding="{Binding ActivationStatus}" Width="90" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="连接状态" Binding="{Binding ConnectionStatus}" Width="90" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="当前考生" Binding="{Binding Candidate}" Width="110" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="班级" Binding="{Binding ClassText}" Width="75" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="准考证号" Binding="{Binding AdmissionNo}" Width="110" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="考试" Binding="{Binding ExamName}" Width="160" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="当前页面" Binding="{Binding Page}" Width="110" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="最后有效通信" Binding="{Binding LastSeen}" Width="140" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="勾选本页全部" Style="{StaticResource ActionButton}" Command="{Binding Activation.SelectAllDevicesCommand}"/>
                                <Button Content="取消勾选" Style="{StaticResource ActionButton}" Command="{Binding Activation.ClearDeviceSelectionCommand}"/>
                                <ComboBox ItemsSource="{Binding Activation.GroupChoices}" SelectedValue="{Binding Activation.MoveToRoomGroupId, Mode=TwoWay}"
                                    DisplayMemberPath="Name" SelectedValuePath="RoomGroupId" Width="190" Margin="0,0,12,10"/>
                                <TextBox Width="260" Margin="0,0,12,10" ToolTip="转组原因" Text="{Binding Activation.MoveReason, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Content="整批转入所选试场" Style="{StaticResource PrimaryAction}" Command="{Binding Activation.MoveDevicesCommand}"/>
                            </WrapPanel>
                            <TextBlock Text="勾选多台设备可整批转组；未勾选时处理当前选中设备。请填写转组原因，任一设备版本变化都不会部分转组。" Style="{StaticResource CaptionText}"/>
                            <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,14"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="查看选中设备的转组历史" Style="{StaticResource ActionButton}" Command="{Binding Activation.DeviceHistoryCommand}"/>
                                <TextBlock Text="转组历史" Style="{StaticResource CardHeading}"/>
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding Activation.DeviceHistory}" Height="160" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="时间" Binding="{Binding ChangedAt}" Width="170"/>
                                    <DataGridTextColumn Header="原试场" Binding="{Binding FromGroupName}" Width="*"/>
                                    <DataGridTextColumn Header="新试场" Binding="{Binding ToGroupName}" Width="*"/>
                                    <DataGridTextColumn Header="操作账号" Binding="{Binding Operator}" Width="130"/>
                                    <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardGap}">
                        <StackPanel>
                            <TextBlock Text="试场分组" Style="{StaticResource CardHeading}"/>
                            <TextBlock Text="分组属于当前服务器，与具体考试无关；删除时由服务器检查所有设备，非空试场不能删除。" Style="{StaticResource CardNote}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="新试场名称" Style="{StaticResource FormLabel}"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="新增" Style="{StaticResource ActionButton}" Margin="12,0,0,0" VerticalAlignment="Top" Command="{Binding Activation.AddGroupCommand}"/>
                                        <TextBox Text="{Binding Activation.NewGroupName, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="选中试场的新名称" Style="{StaticResource FormLabel}"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="重命名" Style="{StaticResource ActionButton}" Margin="12,0,0,0" VerticalAlignment="Top" Command="{Binding Activation.RenameGroupCommand}"/>
                                        <TextBox Text="{Binding Activation.SelectedGroupName, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Grid>
                            <DataGrid ItemsSource="{Binding Activation.Groups}" SelectedItem="{Binding Activation.SelectedGroup}" Height="170" Margin="0,10,0,8" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="试场名称" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="设备数" Binding="{Binding DeviceCount}" Width="140"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Content="删除选中的空试场" Style="{StaticResource Btn.Danger}" HorizontalAlignment="Left" Command="{Binding Activation.RemoveGroupCommand}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding Activation.Status}" Style="{StaticResource StatusLine}"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- 考务账号：仅管理员可见。批准新注册的账号，停用或重新启用账号。 -->
        <TabItem Header="考务账号管理" Tag="{StaticResource Icon.Lock}"
                 Visibility="{Binding Connection.IsAdministrator, Converter={StaticResource BoolToVis}}">
            <ScrollViewer Style="{StaticResource PageScroller}">
                <StackPanel Style="{StaticResource PageBody}">
                    <DockPanel Margin="0,0,0,20">
                        <Button DockPanel.Dock="Right" Content="刷新" Style="{StaticResource ActionButton}" Margin="0" VerticalAlignment="Center"
                                Command="{Binding Accounts.RefreshCommand}"/>
                        <HeaderedContentControl Style="{StaticResource PageHeading}" Header="考务账号管理" Tag="{StaticResource Icon.Lock}" Margin="0"
                                                Content="新注册的考务账号经管理员批准后才能登录；账号停用后立即退出登录。" />
                    </DockPanel>
                    <TextBlock Text="{Binding Accounts.Status}" Style="{StaticResource CaptionText}" Margin="0,0,0,12"/>
                    <Border Style="{StaticResource CardGap}">
                        <DataGrid ItemsSource="{Binding Accounts.Accounts}" IsReadOnly="True" MinHeight="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="姓名" Binding="{Binding DisplayName}" Width="*"/>
                                <DataGridTextColumn Header="用户名" Binding="{Binding Username}" Width="*"/>
                                <DataGridTextColumn Header="角色" Binding="{Binding RoleText}" Width="110"/>
                                <DataGridTemplateColumn Header="状态" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <controls:StatusPill Text="{Binding StatusText}" Level="{Binding StatusLevel}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="注册时间" Binding="{Binding CreatedText}" Width="150"/>
                                <DataGridTemplateColumn Header="操作" Width="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="{Binding ApproveText}" Style="{StaticResource Btn.Primary}" MinWidth="72" Padding="10,0" Margin="0,0,8,0"
                                                        Command="{Binding ApproveCommand}"/>
                                                <Button Content="停用" Style="{StaticResource Btn.Secondary}" MinWidth="72" Padding="10,0"
                                                        Command="{Binding DisableCommand}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>


        </TabControl>
        </Grid>
    </Grid>
</Window>
