<UserControl x:Class="Exam.Admin.Views.RegistrationSuccessPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.Background}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}"
                Width="560" Padding="32" Margin="24"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <Grid Width="80" Height="80" HorizontalAlignment="Center"
                      AutomationProperties.Name="注册成功">
                    <Ellipse Fill="{DynamicResource Brush.Success}" />
                    <Path Data="M 22,41 L 35,54 L 58,29"
                          Stroke="{DynamicResource Brush.OnPrimary}"
                          StrokeThickness="6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" />
                </Grid>
                <TextBlock Text="{Binding Status}" Style="{StaticResource PageTitle}"
                           TextAlignment="Center" TextWrapping="Wrap"
                           Margin="0,24,0,28" />
                <Button Content="确定" Style="{StaticResource Btn.Primary}"
                        MinWidth="96" Padding="14,0"
                        Height="{StaticResource Control.Height.Large}"
                        HorizontalAlignment="Center" IsDefault="True"
                        Command="{Binding AcknowledgeRegistrationCommand}" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
