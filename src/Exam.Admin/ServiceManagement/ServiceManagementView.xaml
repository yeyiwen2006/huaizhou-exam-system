<UserControl x:Class="Exam.Admin.ServiceManagement.ServiceManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Exam.Desktop.Shared.Controls;assembly=Exam.Desktop.Shared"
             Background="{DynamicResource Brush.Background}">
    <UserControl.Resources>
        <Style x:Key="Management.Action" TargetType="Button" BasedOn="{StaticResource Btn.Secondary}">
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
        <Style x:Key="Management.Field" TargetType="TextBox" BasedOn="{StaticResource Tbx.Base}">
            <Setter Property="Margin" Value="0,4,12,12"/>
        </Style>
        <Style x:Key="Management.Section" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="Management.Message" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,12,0,12"/>
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
        <Border Style="{StaticResource TopBar}" Padding="28,24">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="返回考务" Style="{StaticResource Btn.Secondary}" Click="OnBack" VerticalAlignment="Center"/>
                <Button x:Name="RefreshServersButton" DockPanel.Dock="Right" Content="刷新"
                        Style="{StaticResource Btn.Secondary}" Margin="0,0,8,0" VerticalAlignment="Center"
                        Command="{Binding RefreshCommand}"/>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="服务器管理" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{Binding TargetText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                               Margin="0,8,0,0" LineHeight="20"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Background="{DynamicResource Brush.Background}" Padding="28,12,28,0">
            <StackPanel>
                <controls:Banner Level="Warning" IsOpen="{Binding ShowProtectionWarning}" Message="{Binding ProtectionText}"/>
                <TextBlock Text="{Binding DisplayMessage}" Style="{StaticResource Management.Message}"/>
                <TextBlock Text="{Binding HighAvailabilityFailureText}" Style="{StaticResource Management.Message}"/>
                <TextBlock Text="{Binding RecoveryLoginNotice}" Style="{StaticResource Management.Message}"/>
            </StackPanel>
        </Border>
            <StackPanel Margin="{StaticResource Padding.Page}">
                <Border Style="{StaticResource Management.Section}" Visibility="{Binding ShowManagementLogin, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="管理连接" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding ConnectionStatus}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                        <Button Content="重新连接" Style="{StaticResource Management.Action}"
                                Command="{Binding ReconnectCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
                <Border x:Name="HighAvailabilityCard" Style="{StaticResource Management.Section}">
                    <StackPanel>
                        <TextBlock Text="主备运行与故障接管" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding HighAvailabilityVersionText}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <DataGrid x:Name="ServerNodesGrid" ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                                  SelectionMode="Single" SelectionUnit="FullRow" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" Height="138" HeadersVisibility="Column"
                                  HorizontalScrollBarVisibility="Auto" Margin="0,0,0,16">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="节点" Binding="{Binding NodeId}" Width="*" MinWidth="160"/>
                                <DataGridTextColumn Header="角色" Binding="{Binding Role}" Width="100"/>
                                <DataGridTextColumn Header="连接" Binding="{Binding Reachability}" Width="96"/>
                                <DataGridTextColumn Header="数据库" Binding="{Binding Recovery}" Width="96"/>
                                <DataGridTextColumn Header="重放差值/字节" Binding="{Binding ReplayLag}" Width="120"/>
                                <DataGridTextColumn Header="解锁材料" Binding="{Binding Keys}" Width="96"/>
                                <DataGridTextColumn Header="证书" Binding="{Binding Certificate}" Width="88"/>
                                <DataGridTextColumn Header="观察时间" Binding="{Binding ObservedAt}" Width="170"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="所选服务器节点" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TakeoverTargetInput" Style="{StaticResource Management.Field}"
                                         Text="{Binding HighAvailabilityTarget, Mode=OneWay}" IsReadOnly="True"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="备注（选填）" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource Management.Field}" Text="{Binding HighAvailabilityReason, UpdateSourceTrigger=PropertyChanged}" MaxLength="500"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="TakeoverPrimaryButton" Content="接管为主服务器"
                                Style="{StaticResource Btn.Primary}" Command="{Binding TakeoverCommand}"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="接管为主服务器"/>
                            <Button x:Name="RebuildIsolatedButton" Content="重建隔离的服务器并作为备机"
                                Style="{StaticResource Btn.Secondary}" Command="{Binding RebuildCommand}"
                                Margin="8,0,0,0"
                                AutomationProperties.Name="重建隔离的服务器并作为备机"/>
                            <Button x:Name="CancelHighAvailabilityButton" Content="{Binding CancelHighAvailabilityText}"
                                Style="{StaticResource Btn.Secondary}" Command="{Binding CancelHighAvailabilityCommand}"
                                Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="ServerStatusCard" Style="{StaticResource Management.Section}">
                    <StackPanel>
                        <TextBlock Text="服务器状态" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource Brush.Background}" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="主机" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="PrimaryServerStatus" Text="{Binding PrimaryServerStatusText}"
                                               Style="{StaticResource BodyText}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{DynamicResource Brush.Background}" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="备机" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="StandbyServerStatus" Text="{Binding StandbyServerStatusText}"
                                               Style="{StaticResource BodyText}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <WrapPanel Margin="0,16,0,0">
                            <Button Content="运行状态检测" Style="{StaticResource Management.Action}" Command="{Binding ChecksCommand}"/>
                            <Button Content="取消等待" Style="{StaticResource Management.Action}" Command="{Binding CancelWaitCommand}"/>
                        </WrapPanel>
                        <ItemsControl ItemsSource="{Binding Checks}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Result}" Style="{StaticResource BodyText}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding WriteGate}" Style="{StaticResource BodyText}" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border x:Name="AutomaticBackupCard" Style="{StaticResource Management.Section}">
                    <StackPanel>
                        <TextBlock Text="自动备份与磁盘" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding AutomaticBackupText}" Style="{StaticResource BodyText}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border x:Name="OperationLogsCard" Style="{StaticResource Management.Section}">
                    <StackPanel>
                        <TextBlock Text="操作与事件日志" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                        <TextBlock Text="合并显示主备节点最近的操作和事件，按时间排列。" Style="{StaticResource CaptionText}" Margin="0,0,0,12"/>
                        <DataGrid x:Name="OperationLogsGrid" ItemsSource="{Binding Logs}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="320">
                            <DataGrid.Template>
                                <ControlTemplate TargetType="DataGrid">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                                        <ScrollViewer x:Name="DG_ScrollViewer" Focusable="False"
                                                      CanContentScroll="True"
                                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                            <ScrollViewer.Template>
                                                <ControlTemplate TargetType="ScrollViewer">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                        <DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter"/>
                                                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Row="1"
                                                                                CanContentScroll="{TemplateBinding CanContentScroll}"/>
                                                        <!-- Keep the header fixed while the vertical track reaches the table's top edge. -->
                                                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Grid.RowSpan="2"
                                                                   Orientation="Vertical" Maximum="{TemplateBinding ScrollableHeight}"
                                                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                                                   Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                                                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="2"
                                                                   Orientation="Horizontal" Maximum="{TemplateBinding ScrollableWidth}"
                                                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                                                   Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                                                    </Grid>
                                                </ControlTemplate>
                                            </ScrollViewer.Template>
                                            <ItemsPresenter SnapsToDevicePixels="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </ControlTemplate>
                            </DataGrid.Template>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="Auto"/>
                                <DataGridTextColumn Header="节点" Binding="{Binding Node}" Width="95"/>
                                <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="Auto"/>
                                <DataGridTextColumn Header="请求编号或事件编号" Binding="{Binding Identifier}" Width="Auto"/>
                                <DataGridTextColumn Header="类别" Binding="{Binding Kind}" Width="*" MinWidth="260"/>
                                <DataGridTextColumn Header="结果或事件级别" Binding="{Binding ResultOrEventLevel}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
