<UserControl x:Class="Exam.Admin.Reporting.ReportPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:reporting="clr-namespace:Exam.Admin.Reporting"
             Background="{DynamicResource Brush.Background}" FontFamily="{DynamicResource Font.Family}"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
    </UserControl.Resources>
    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头：与其他考务页面一致的图标块 + 标题 + 用途说明，右侧为报表开放状态 -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <DockPanel>
                <Border Style="{DynamicResource IconTile}" Width="40" Height="40" CornerRadius="10">
                    <Path Data="{DynamicResource Icon.Chart}" Style="{DynamicResource IconTile.Glyph}" Width="20" Height="20" />
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="成绩统计" Style="{DynamicResource PageTitle}" />
                    <TextBlock Text="同一快照呈现排名、作答与班级表现；Excel 导出与表格同源。" Style="{DynamicResource PageSubtitle}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
            <Border Grid.Column="1" Style="{DynamicResource Report.StateBadge}" Margin="12,0,0,0">
                <TextBlock x:Name="StateBadgeText" Text="{Binding StateLabel}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text.Primary}" AutomationProperties.LiveSetting="Polite" />
            </Border>
        </Grid>

        <!-- 考试选择与操作 -->
        <Border Grid.Row="1" Style="{DynamicResource Card.Flat}" Padding="14,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="当前考试" Style="{DynamicResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBox x:Name="ExamSelector" Grid.Column="1" MaxWidth="420" HorizontalAlignment="Stretch" Margin="0,0,16,0"
                         Text="{Binding ExamId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="考试标识"
                         ToolTip="输入考试标识；切换考试会立即隐藏原报表。" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="刷新报表" Command="{Binding RefreshCommand}" Style="{DynamicResource Btn.Secondary}" MinWidth="104" Margin="0,0,8,0" />
                    <Button x:Name="ExportButton" Content="导出 Excel" Command="{Binding ExportCommand}" Style="{DynamicResource Btn.Primary}" MinWidth="120" Margin="0,0,8,0" />
                    <Button Content="取消" Command="{Binding CancelCommand}" Style="{DynamicResource Btn.Ghost}" MinWidth="56" Height="36" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 权威状态摘要：只显示服务器返回值，不在本机重算 -->
        <UniformGrid x:Name="SummaryCards" Grid.Row="2" Columns="4" Margin="0,0,0,10">
            <Border Style="{DynamicResource Report.Metric}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="实际参试" Style="{DynamicResource Report.MetricLabel}" />
                    <TextBlock Text="{Binding ParticipantCountText}" Style="{DynamicResource Report.MetricValue}" />
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource Report.Metric}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="已回收答卷" Style="{DynamicResource Report.MetricLabel}" />
                    <TextBlock Text="{Binding CollectedCountText}" Style="{DynamicResource Report.MetricValue}" />
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource Report.Metric}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="当前版本已计分" Style="{DynamicResource Report.MetricLabel}" />
                    <TextBlock Text="{Binding GradedCountText}" Style="{DynamicResource Report.MetricValue}" />
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource Report.Metric}">
                <StackPanel>
                    <TextBlock Text="计分规则版本" Style="{DynamicResource Report.MetricLabel}" />
                    <TextBlock Text="{Binding GradingVersionText}" Style="{DynamicResource Report.MetricValue}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="3" Style="{DynamicResource Hint}" Background="{DynamicResource Brush.Primary.Soft}" Padding="12,6" Margin="0,0,0,10">
            <TextBlock Text="{Binding Status}" Style="{DynamicResource HintText}" AutomationProperties.LiveSetting="Polite" />
        </Border>

        <Border Grid.Row="4" Style="{DynamicResource Report.Panel}" Margin="0,0,0,10" Padding="14,10"
                Visibility="{Binding HasMissingParticipants, Converter={StaticResource VisibleWhenTrue}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="待回收答卷" Style="{DynamicResource SectionTitle}" Margin="0,0,0,8" />
                <DataGrid ItemsSource="{Binding MissingParticipants}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" MaxHeight="110" BorderThickness="0" ColumnHeaderStyle="{DynamicResource Report.ColumnHeader}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="准考证号" Binding="{Binding ExamNumber}" Width="*" />
                        <DataGridTextColumn Header="姓名" Binding="{Binding DisplayName}" Width="*" />
                        <DataGridTextColumn Header="班级" Binding="{Binding ClassNumber}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <reporting:ReportWorkspaceView Grid.Row="5" DataContext="{Binding Session}" />
    </Grid>
</UserControl>
