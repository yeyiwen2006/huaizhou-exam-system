<UserControl x:Class="Exam.Admin.Reporting.ReportWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:reporting="clr-namespace:Exam.Admin.Reporting"
             UseLayoutRounding="True">
    <Border Style="{DynamicResource Report.Panel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="报表视图" VerticalAlignment="Center" Margin="0,0,12,0" Style="{DynamicResource SectionTitle}" />
                    <ComboBox x:Name="TableChooser" Grid.Column="1" MaxWidth="380" HorizontalAlignment="Left" MinWidth="240"
                              MinHeight="34" ItemsSource="{Binding Tables}" DisplayMemberPath="Title"
                              SelectedItem="{Binding SelectedTable, Mode=TwoWay}" IsEnabled="{Binding HasTables}"
                              AutomationProperties.Name="选择报表视图" />
                    <TextBlock Grid.Column="2" Text="只读视图 · 与 Excel 同源" Style="{DynamicResource CaptionText}"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
            </Border>
            <reporting:ReportTableView Grid.Row="1" Table="{Binding SelectedTable}" UnavailableReason="{Binding UnavailableReason}" />
        </Grid>
    </Border>
</UserControl>
