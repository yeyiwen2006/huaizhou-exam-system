<UserControl x:Class="Exam.Admin.Reporting.ReportWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:reporting="clr-namespace:Exam.Admin.Reporting">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="报表视图" VerticalAlignment="Center" Margin="0,0,12,0"
                       Style="{DynamicResource CaptionText}" />
            <ComboBox x:Name="TableChooser" Width="280" MinHeight="34"
                      ItemsSource="{Binding Tables}" DisplayMemberPath="Title"
                      SelectedItem="{Binding SelectedTable, Mode=TwoWay}"
                      IsEnabled="{Binding HasTables}" />
        </StackPanel>
        <reporting:ReportTableView Grid.Row="1" Table="{Binding SelectedTable}"
                                   UnavailableReason="{Binding UnavailableReason}" />
    </Grid>
</UserControl>
