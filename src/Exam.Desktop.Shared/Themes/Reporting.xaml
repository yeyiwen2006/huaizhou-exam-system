<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 成绩报表专用组件：只复用共享色板、字号与圆角，不另建风格。 -->
    <Style x:Key="Report.Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.LG}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="Report.Metric" TargetType="Border" BasedOn="{StaticResource Report.Panel}">
        <Setter Property="Padding" Value="16,8"/>
    </Style>
    <Style x:Key="Report.MetricLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
    </Style>
    <Style x:Key="Report.MetricValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Subtitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="Report.StateBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Alt}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Session.HasTables}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Success.Soft}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Primary.Soft}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Report.ColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Report.Cell" TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="DataGridCell">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate></Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Primary.Soft}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus.Ring}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Geometry x:Key="Report.DocumentIcon">M 5,2 L 17,2 21,6 21,24 5,24 Z M 16,2 L 16,7 21,7 M 9,12 L 17,12 M 9,16 L 17,16 M 9,20 L 14,20</Geometry>
</ResourceDictionary>
