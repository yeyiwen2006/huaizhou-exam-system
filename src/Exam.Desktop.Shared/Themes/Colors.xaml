<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      颜色规范（浅色主题）
      基础色板 + 语义色。
      语义色约定（全系统统一，禁止页面另行硬编码）：
        Brush.Answer  —— 已作答（绿色填充）
        Brush.Mark    —— 私人标记（红色圆点）
        Brush.Danger  —— 提交答卷 / 退出系统等危险操作（红色）
    -->

    <!-- 品牌主色 -->
    <SolidColorBrush x:Key="Brush.Primary" Color="#1E5AA8" />
    <SolidColorBrush x:Key="Brush.Primary.Hover" Color="#1A4F93" />
    <SolidColorBrush x:Key="Brush.Primary.Pressed" Color="#164079" />
    <SolidColorBrush x:Key="Brush.Primary.Soft" Color="#EAF1FB" />
    <SolidColorBrush x:Key="Brush.Primary.Variant" Color="#5B8AD4" />
    <SolidColorBrush x:Key="Brush.OnPrimary" Color="#FFFFFF" />

    <!-- 品牌渐变：登录/激活卡片顶部与侧栏标识，只作装饰，不承载语义 -->
    <LinearGradientBrush x:Key="Brush.Brand.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2A6CC4" Offset="0" />
        <GradientStop Color="#173F78" Offset="1" />
    </LinearGradientBrush>

    <!-- 界面基础 -->
    <SolidColorBrush x:Key="Brush.Background" Color="#F3F5F9" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Surface.Alt" Color="#F4F6FA" />
    <SolidColorBrush x:Key="Brush.Border" Color="#E1E6EE" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="#C3CCD9" />

    <!-- 文本 -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#1B2433" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#5F6B7E" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="#9CA3AF" />
    <SolidColorBrush x:Key="Brush.Text.OnDark" Color="#FFFFFF" />

    <!-- 考务端侧栏导航（深色底，仅用于导航外壳） -->
    <SolidColorBrush x:Key="Brush.Nav.Background" Color="#132A4C" />
    <SolidColorBrush x:Key="Brush.Nav.Hover" Color="#1C3863" />
    <SolidColorBrush x:Key="Brush.Nav.Selected" Color="#24467A" />
    <SolidColorBrush x:Key="Brush.Nav.Accent" Color="#7DB2FF" />
    <SolidColorBrush x:Key="Brush.Nav.Text" Color="#B9C7DD" />
    <SolidColorBrush x:Key="Brush.Nav.Text.Muted" Color="#7F93B3" />
    <SolidColorBrush x:Key="Brush.Nav.Divider" Color="#26406A" />

    <!-- 语义色：成功 / 已作答 -->
    <SolidColorBrush x:Key="Brush.Success" Color="#2E9E5B" />
    <SolidColorBrush x:Key="Brush.Success.Hover" Color="#288C50" />
    <SolidColorBrush x:Key="Brush.Success.Pressed" Color="#227A45" />
    <SolidColorBrush x:Key="Brush.Success.Soft" Color="#E7F6ED" />
    <SolidColorBrush x:Key="Brush.Answer" Color="#2E9E5B" />
    <SolidColorBrush x:Key="Brush.Answer.Soft" Color="#2E9E5B" Opacity="0.18" />

    <!-- 语义色：警告 -->
    <SolidColorBrush x:Key="Brush.Warning" Color="#D97706" />
    <SolidColorBrush x:Key="Brush.Warning.Soft" Color="#FDF3E3" />

    <!-- 语义色：危险 / 私人标记 -->
    <SolidColorBrush x:Key="Brush.Danger" Color="#D64545" />
    <SolidColorBrush x:Key="Brush.Danger.Hover" Color="#C03B3B" />
    <SolidColorBrush x:Key="Brush.Danger.Pressed" Color="#A93333" />
    <SolidColorBrush x:Key="Brush.Danger.Soft" Color="#FBEAEA" />
    <SolidColorBrush x:Key="Brush.Mark" Color="#E04B4B" />

    <!-- 语义色：信息 -->
    <SolidColorBrush x:Key="Brush.Info" Color="#1E5AA8" />
    <SolidColorBrush x:Key="Brush.Info.Soft" Color="#EAF1FB" />

    <!-- 焦点与覆盖 -->
    <SolidColorBrush x:Key="Brush.Focus.Ring" Color="#8FB8E8" />
    <SolidColorBrush x:Key="Brush.Busy.Overlay" Color="#F3F5F9" Opacity="0.78" />
    <SolidColorBrush x:Key="Brush.Scrim" Color="#F2FFFFFF" />

    <!-- 阴影资源 -->
    <DropShadowEffect x:Key="Effect.Card" BlurRadius="18" ShadowDepth="2"
                      Direction="270" Opacity="0.06" Color="#1B2433" />
    <DropShadowEffect x:Key="Effect.Popup" BlurRadius="24" ShadowDepth="4"
                      Direction="270" Opacity="0.16" Color="#1B2433" />

</ResourceDictionary>
