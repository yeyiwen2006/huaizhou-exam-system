<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
      字体与字号规范。
      说明：试题 PDF 内部字体由题目包自身决定（D 模块），不受本主题影响；
      本主题只作用于应用界面与叠加控件。
    -->

    <FontFamily x:Key="Font.Family">Microsoft YaHei UI, Microsoft YaHei, SimHei, SimSun</FontFamily>
    <FontFamily x:Key="Font.Family.Mono">Consolas, Cascadia Mono, Courier New</FontFamily>

    <sys:Double x:Key="Font.Size.Caption">12</sys:Double>
    <sys:Double x:Key="Font.Size.Body">14</sys:Double>
    <sys:Double x:Key="Font.Size.Body.Large">16</sys:Double>
    <sys:Double x:Key="Font.Size.Subtitle">18</sys:Double>
    <sys:Double x:Key="Font.Size.Title">22</sys:Double>
    <sys:Double x:Key="Font.Size.Display">32</sys:Double>

</ResourceDictionary>
