<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      线性图标（24×24 坐标，描边绘制，配合 Style="{StaticResource Icon.Stroke}" 使用）。
      图标只作识别辅助，含义始终由相邻文字表达。
    -->

    <Geometry x:Key="Icon.Logo">M12 2.5 L21 7 L12 11.5 L3 7 Z M6 9 L6 14.5 C6 16.5 9 18.5 12 18.5 C15 18.5 18 16.5 18 14.5 L18 9 M21 7 L21 13</Geometry>
    <Geometry x:Key="Icon.Calendar">M4 6 L20 6 L20 20 L4 20 Z M4 10 L20 10 M8 3.5 L8 7.5 M16 3.5 L16 7.5 M8 14 L10 14 M14 14 L16 14 M8 17 L10 17</Geometry>
    <Geometry x:Key="Icon.Users">M9 4 A3.5 3.5 0 1 0 9 11 A3.5 3.5 0 1 0 9 4 Z M2.5 20 C2.5 16.5 5.5 14.5 9 14.5 C12.5 14.5 15.5 16.5 15.5 20 M16 4.6 A3.2 3.2 0 0 1 16 10.8 M17.5 14.6 C20 15.2 21.5 17.2 21.5 20</Geometry>
    <Geometry x:Key="Icon.Device">M3 5 L21 5 L21 16 L3 16 Z M9 20 L15 20 M12 16 L12 20</Geometry>
    <Geometry x:Key="Icon.Monitor">M3 12 L7 12 L9.5 6 L14 18 L16.5 12 L21 12</Geometry>
    <Geometry x:Key="Icon.Checklist">M5 3.5 L19 3.5 L19 20.5 L5 20.5 Z M8.5 9 L10 10.5 L13 7.5 M8.5 15 L10 16.5 L13 13.5 M15 9.5 L16.5 9.5 M15 15.5 L16.5 15.5</Geometry>
    <Geometry x:Key="Icon.Chart">M4 20 L20 20 M7 16 L7 11 M12 16 L12 6 M17 16 L17 9</Geometry>
    <Geometry x:Key="Icon.Layers">M12 3 L21 8 L12 13 L3 8 Z M3 12.5 L12 17.5 L21 12.5 M3 17 L12 22 L21 17</Geometry>
    <Geometry x:Key="Icon.Server">M4 4 L20 4 L20 10 L4 10 Z M4 14 L20 14 L20 20 L4 20 Z M7.5 7 L8.5 7 M7.5 17 L8.5 17</Geometry>
    <Geometry x:Key="Icon.Lock">M5 11 L19 11 L19 21 L5 21 Z M8 11 L8 7.5 C8 5 9.8 3.5 12 3.5 C14.2 3.5 16 5 16 7.5 L16 11 M12 15 L12 17</Geometry>
    <Geometry x:Key="Icon.Clock">M12 3 A9 9 0 1 0 12.001 3 Z M12 7 L12 12 L15.5 14</Geometry>
    <Geometry x:Key="Icon.Document">M6 3 L14 3 L19 8 L19 21 L6 21 Z M14 3 L14 8 L19 8 M9 13 L16 13 M9 17 L14 17</Geometry>
    <Geometry x:Key="Icon.Refresh">M20 11 A8 8 0 1 0 17.7 16.7 M20 4.5 L20 11 L13.5 11</Geometry>
    <Geometry x:Key="Icon.Download">M12 4 L12 15 M7.5 10.5 L12 15 L16.5 10.5 M4.5 19.5 L19.5 19.5</Geometry>

    <!-- 描边图标通用样式 -->
    <Style x:Key="Icon.Stroke" TargetType="Path">
        <Setter Property="Stroke" Value="{DynamicResource Brush.Primary}" />
        <Setter Property="StrokeThickness" Value="1.7" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="{DynamicResource Icon.Size}" />
        <Setter Property="Height" Value="{DynamicResource Icon.Size}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

</ResourceDictionary>
