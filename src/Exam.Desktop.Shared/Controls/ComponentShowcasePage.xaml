<UserControl x:Class="Exam.Desktop.Shared.Controls.ComponentShowcasePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Exam.Desktop.Shared.Controls"
             Background="{DynamicResource Brush.Background}">
    <!--
      组件样例页：M1 验收用，覆盖共享主题全部基础组件与语义色。
      学生端与考务端均应能以此页核对视觉一致性。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="900" HorizontalAlignment="Left">

            <TextBlock Style="{StaticResource PageTitle}" Text="共享组件样例页" />
            <TextBlock Style="{StaticResource CaptionText}"
                       Text="Exam.Desktop.Shared · 供 C 评审与学生端/考务端一致性核对"
                       Margin="0,4,0,20" />

            <!-- 1. 页头 -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="1. 页头（编号 + 姓名 + 右侧操作）" />
            <Border Style="{StaticResource Card}" Margin="0,8,0,16">
                <controls:PageHeader ClientNumber="042"
                                     CandidateName="张三"
                                     ClassText="高三(2)班">
                    <controls:PageHeader.RightContent>
                        <Button Style="{StaticResource Btn.Danger}" Content="退出系统" />
                    </controls:PageHeader.RightContent>
                </controls:PageHeader>
            </Border>

            <!-- 2. 按钮 -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="2. 按钮族" />
            <Border Style="{StaticResource Card}" Margin="0,8,0,16">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Btn.Primary}" Content="主按钮" Width="96" />
                    <Button Style="{StaticResource Btn.Secondary}" Content="次级按钮" Width="96" Margin="12,0,0,0" />
                    <Button Style="{StaticResource Btn.Danger}" Content="提交答卷" Width="96" Margin="12,0,0,0" />
                    <Button Style="{StaticResource Btn.Primary}" Content="禁用态" Width="96" Margin="12,0,0,0" IsEnabled="False" />
                    <Button Style="{StaticResource Btn.Ghost}" Content="取消激活（小字链接型）" Margin="12,0,0,0" />
                </StackPanel>
            </Border>

            <!-- 3. 输入与校验 -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="3. 输入与校验" />
            <Border Style="{StaticResource Card}" Margin="0,8,0,16">
                <StackPanel>
                    <controls:ValidatedInput Label="姓名"
                                              Watermark="请输入姓名"
                                              Text="张三" />
                    <controls:ValidatedInput Label="班级（仅数字）"
                                              Watermark="请输入班级，如 2"
                                              IsNumericOnly="True"
                                              Text="2"
                                              Margin="0,12,0,0" />
                    <controls:ValidatedInput Label="准考证号（仅数字）"
                                              Watermark="请输入准考证号"
                                              IsNumericOnly="True"
                                              Text="abc"
                                              ErrorText="准考证号只能包含数字"
                                              Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <!-- 4. 状态标识 -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="4. 状态标识" />
            <Border Style="{StaticResource Card}" Margin="0,8,0,16">
                <StackPanel Orientation="Horizontal">
                    <controls:StatusPill Text="已登录" Level="Success" />
                    <controls:StatusPill Text="等待开考" Level="Info" Margin="12,0,0,0" />
                    <controls:StatusPill Text="已交卷" Level="Success" Margin="12,0,0,0" />
                    <controls:StatusPill Text="连接中断" Level="Danger" Margin="12,0,0,0" />
                    <controls:StatusPill Text="待批准" Level="Warning" Margin="12,0,0,0" />
                    <controls:StatusPill Text="未登录" Level="Neutral" Margin="12,0,0,0" />
                </StackPanel>
            </Border>

            <!-- 5. 消息条 -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="5. 消息条" />
            <StackPanel Margin="0,8,0,16">
                <controls:Banner Message="当前不可进入该考试！" Level="Danger" IsOpen="True" />
                <controls:Banner Message="试题获取失败！" Level="Danger" IsOpen="True" Margin="0,8,0,0" />
                <controls:Banner Message="激活成功，编号已分配。" Level="Success" IsOpen="True" Margin="0,8,0,0" />
                <controls:Banner Message="开考前 5 分钟将自动下载试题。" Level="Info" IsOpen="True" Margin="0,8,0,0" />
            </StackPanel>

            <!-- 6. 等待遮罩 -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="6. 网络等待遮罩" />
            <Border Style="{StaticResource Card}" Margin="0,8,0,16" Height="140">
                <Grid>
                    <TextBlock Style="{StaticResource BodyText}"
                               Text="页面内容（遮罩覆盖其上）"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <controls:BusyOverlay IsBusy="True" Message="正在请求激活，等待考务端批准…" />
                </Grid>
            </Border>

            <!-- 7. 题号方框 -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="7. 题号方框（已答 / 标记 / 当前）" />
            <Border Style="{StaticResource Card}" Margin="0,8,0,16">
                <StackPanel Orientation="Horizontal">
                    <controls:QuestionBox Number="1" />
                    <controls:QuestionBox Number="2" IsAnswered="True" Margin="8,0,0,0" />
                    <controls:QuestionBox Number="3" IsMarked="True" Margin="8,0,0,0" />
                    <controls:QuestionBox Number="4" IsAnswered="True" IsMarked="True" Margin="8,0,0,0" />
                    <controls:QuestionBox Number="5" IsCurrent="True" Margin="8,0,0,0" />
                    <TextBlock Style="{StaticResource CaptionText}"
                               Text="已作答填充绿色；标记显示右上角红点；当前题主色描边。"
                               VerticalAlignment="Center" Margin="16,0,0,0" />
                </StackPanel>
            </Border>

            <!-- 8. 表格与固定行 -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="8. 表格与固定平均分行" />
            <Border Style="{StaticResource Card}" Margin="0,8,0,16">
                <StackPanel>
                    <DataGrid MinHeight="112">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="排名" Binding="{Binding Rank}" Width="60" />
                            <DataGridTextColumn Header="准考证号" Binding="{Binding AdmissionNo}" Width="100" />
                            <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="80" />
                            <DataGridTextColumn Header="班级" Binding="{Binding ClassText}" Width="60" />
                            <DataGridTextColumn Header="成绩" Binding="{Binding Score}" Width="80" />
                        </DataGrid.Columns>
                        <DataGrid.Items>
                            <controls:SampleRow Rank="1" AdmissionNo="2026001" Name="张三" ClassText="1" Score="98" />
                            <controls:SampleRow Rank="2" AdmissionNo="2026002" Name="李四" ClassText="1" Score="95" />
                            <controls:SampleRow Rank="3" AdmissionNo="2026003" Name="王五" ClassText="2" Score="92" />
                        </DataGrid.Items>
                    </DataGrid>
                    <Border Style="{StaticResource TableFooterRow}" Margin="0">
                        <TextBlock Style="{StaticResource BodyText}" FontWeight="Bold"
                                   Text="平均分　　　96.50" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- 9. 进度条 -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="9. 进度条" />
            <Border Style="{StaticResource Card}" Margin="0,8,0,16">
                <StackPanel>
                    <ProgressBar Minimum="0" Maximum="100" Value="64" />
                    <ProgressBar Minimum="0" Maximum="100" IsIndeterminate="True" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
