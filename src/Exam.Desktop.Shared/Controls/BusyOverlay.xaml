<UserControl x:Class="Exam.Desktop.Shared.Controls.BusyOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      网络等待遮罩：所有网络等待均须可见。
      IsBusy=True 时半透明覆盖全区域并阻断输入。
    -->
    <UserControl.Resources>
        <Storyboard x:Key="Spin" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:0.9" />
        </Storyboard>
    </UserControl.Resources>
    <Grid x:Name="Root"
          Visibility="Collapsed"
          Background="{DynamicResource Brush.Busy.Overlay}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid Width="40" Height="40"
                  RenderTransformOrigin="0.5,0.5"
                  HorizontalAlignment="Center">
                <Grid.RenderTransform>
                    <RotateTransform x:Name="SpinnerRotate" />
                </Grid.RenderTransform>
                <Ellipse Width="40" Height="40"
                         Stroke="{DynamicResource Brush.Primary.Soft}"
                         StrokeThickness="4" />
                <Ellipse Width="40" Height="40"
                         Stroke="{DynamicResource Brush.Primary}"
                         StrokeThickness="4"
                         StrokeDashArray="26 100" />
            </Grid>
            <TextBlock x:Name="MessageText"
                       Text="正在连接服务器…"
                       FontSize="{DynamicResource Font.Size.Body}"
                       Foreground="{DynamicResource Brush.Text.Primary}"
                       Margin="0,12,0,0"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
