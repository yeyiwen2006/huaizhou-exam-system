<UserControl x:Class="Exam.Desktop.Shared.Controls.Banner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      消息条：错误 / 提示 / 成功 / 警告。
      用于“当前不可进入该考试！”“试题获取失败！”等业务反馈。
    -->
    <UserControl.Resources>
        <Geometry x:Key="Icon.Alert">M12 2 L23 21 L1 21 Z M12 9 L12 15 M12 17.6 L12 19</Geometry>
        <Geometry x:Key="Icon.Check">M3 8.5 L8 13.5 L17 4</Geometry>
        <Geometry x:Key="Icon.Info">M12 3 A9 9 0 1 0 12.001 3 Z M12 10.5 L12 17 M12 7.2 L12 7.3</Geometry>
        <Geometry x:Key="Icon.Warn">M12 3 A9 9 0 1 0 12.001 3 Z M12 7 L12 13 M12 16 L12 16.1</Geometry>
    </UserControl.Resources>
    <Border x:Name="Root"
            CornerRadius="{DynamicResource Radius.MD}"
            Padding="12,8"
            Background="{DynamicResource Brush.Danger.Soft}"
            Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
            <Path x:Name="Icon"
                  Data="{StaticResource Icon.Alert}"
                  Stroke="{DynamicResource Brush.Danger}"
                  StrokeThickness="1.6"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  Width="18" Height="18"
                  Stretch="Uniform"
                  VerticalAlignment="Center" />
            <TextBlock x:Name="MessageText"
                       Text=""
                       FontSize="{DynamicResource Font.Size.Body}"
                       Foreground="{DynamicResource Brush.Text.Primary}"
                       Margin="8,0,0,0"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
