<UserControl x:Class="Exam.Desktop.Shared.Controls.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      统一页头：左上角设备编号 + 考生姓名（全端一致）。
      右侧为 RightContent 插槽，用于各页面右上角操作（退出系统 / 返回 / 提交答卷等红色按钮）。
    -->
    <Border Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,0,1"
            Padding="20,10"
            MinHeight="60">
        <DockPanel LastChildFill="False">
            <ContentPresenter DockPanel.Dock="Right"
                              Content="{Binding RightContent, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 设备编号徽标 -->
                <Border Background="{DynamicResource Brush.Primary.Soft}"
                        CornerRadius="{DynamicResource Radius.Pill}"
                        Padding="10,5,12,5"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{DynamicResource Icon.Device}"
                              Stroke="{DynamicResource Brush.Primary}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="Uniform"
                              Width="14" Height="14"
                              Margin="0,0,6,0"
                              VerticalAlignment="Center" />
                        <TextBlock x:Name="NumberText"
                                   Text="未激活"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Primary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Width="1" Height="20" Margin="14,0"
                        Background="{DynamicResource Brush.Border}"
                        VerticalAlignment="Center" />
                <TextBlock x:Name="NameText"
                           Text="未登录"
                           FontSize="{DynamicResource Font.Size.Body.Large}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="ClassTextBlock"
                           Text=""
                           FontSize="{DynamicResource Font.Size.Caption}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Margin="8,3,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
